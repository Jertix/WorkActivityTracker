    /// <summary>Indice di navigazione nello storico Changeset (-1 = stato corrente non salvato)</summary>
    private int _changesetHistoryIndex = -1;
    /// <summary>Contenuto HTML corrente prima dell'inizio della navigazione undo Changeset</summary>
    private string? _changesetContenutoSalvato;

    // ===== Visibilità modali storico =====
    /// <summary>Controlla la visibilità della modale storico Note</summary>
    private bool _mostraStoriciNote = false;
    /// <summary>Controlla la visibilità della modale storico Changeset</summary>
    private bool _mostraStoriciChangeset = false;

    /// <summary>ID utente corrente (cacheato da OnInitializedAsync)</summary>
    private int _utenteCorrenteId;

    /// <summary>Visibilità della modale editor clienti</summary>
    private bool mostraEditorClienti = false;

    /// <summary>Visibilità della modale segnalazioni</summary>
    private bool mostraSegnalazioni = false;

    /// <summary>Contatore delle segnalazioni non risolte (per il badge)</summary>
    private int segnalazioniCount = 0;

    /// <summary>Percorso dell'ultimo file esportato (mostrato nella barra di stato)</summary>
    private string ultimoExport = string.Empty;

    // Filtri di ricerca
    private int? FiltroAnno { get; set; }
    private int? FiltroMese { get; set; }
    private int? FiltroGiorno { get; set; }
    private int? FiltroSettimana { get; set; }
    private string TestoRicerca { get; set; } = string.Empty;

    // Stati dell'interfaccia
    private bool isLoading = true;
    private bool isSaving = false;
    private string messaggio = string.Empty;
    private bool isErrore = false;

    /// <summary>Messaggio (auto-scomparsa) della pulizia automatica dello storico modifiche all'avvio</summary>
    private string messaggioHistoryPulita = string.Empty;

    /// <summary>Banner informativo sull'avanzamento della conversione del testo ricercabile.</summary>
    private string messaggioTestoRicercabile = string.Empty;

    /// <summary>True se su disco c'è una bozza lasciata da un salvataggio fallito.</summary>
    private bool bozzaPresente = false;

    /// <summary>Data/ora della bozza su disco (per il testo del banner).</summary>
    private DateTime? dataBozza = null;

    /// <summary>True se l'anteprima readonly del lavoro dei giorni precedenti è visibile</summary>
    private bool mostraLavoroPrecedente = false;

    /// <summary>HTML dell'anteprima del lavoro dei giorni precedenti (catena "Proseguo l'attività"), immagini/formattazione incluse</summary>
    private string htmlLavoroPrecedente = string.Empty;

    /// <summary>
    /// Cache: true se l'anteprima del lavoro precedente è già stata costruita per la selezione corrente.
    /// Evita di rileggere la catena dal DB ad ogni "Mostra/Nascondi". Azzerato al cambio attività.
    /// </summary>
    private bool lavoroPrecedenteCaricato = false;

    /// <summary>
    /// Regex che individua l'header "**** Proseguo l'attività [Id]..." (cattura l'Id dell'attività collegata).
    /// Usata sia per mostrare il pulsante sia per seguire la catena dei rimandi.
    /// </summary>
    private static readonly System.Text.RegularExpressions.Regex ProseguoRegex =
        new(@"\*{2,}\s*Proseguo l'attività\s+(\d+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase |
            System.Text.RegularExpressions.RegexOptions.Compiled);

    /// <summary>Modalità admin: permette di visualizzare le attività di tutti gli utenti</summary>
    private bool isAdminMode = false;
    
    /// <summary>Indica se è stata eseguita una ricerca (abilita il tasto Dettagli ricerca)</summary>
    private bool ricercaEseguita = false;
    
    /// <summary>Controlla la visibilità della modale di ricerca avanzata</summary>
    private bool mostraModaleRicerca = false;
    
    /// <summary>Filtro per visualizzare solo le attività che contengono TODO</summary>
    private bool filtroSoloTodo = false;

    /// <summary>
    /// Filtro "Visualizza ticket in scadenza": mostra le sole attività con TODO E con la data di
    /// scadenza valorizzata, ordinate dalla scadenza più vicina. Implica il filtro "solo TODO".
    /// </summary>
    private bool filtroTicketInScadenza = false;

    /// <summary>Controlla la visibilità della modale TODO List</summary>
    private bool mostraTodoList = false;
    
    /// <summary>Contatore dei TODO non completati (per il badge)</summary>
    private int todoCount = 0;
    
    /// <summary>Controlla la visibilità della modale editor congelati</summary>
    private bool mostraEditorCongelati = false;

    /// <summary>Controlla la visibilità della modale Appunti</summary>
    private bool mostraAppunti = false;

    /// <summary>Controlla la visibilità della modale Gestione Clienti (v4.7)</summary>
    private bool mostraGestioneClienti = false;

    /// <summary>Contatore degli Appunti (per il badge)</summary>
    private int appuntiCount = 0;

    // ===== Conferma eliminazione (modale custom) =====
    /// <summary>Controlla la visibilità della modale di conferma eliminazione</summary>
    private bool mostraConfermaElimina = false;
    /// <summary>Attività da eliminare (in attesa di conferma)</summary>
    private WorkActivityDto? attivitaDaEliminare = null;

    // ===== Barra di stato =====
    /// <summary>Timestamp dell'ultimo salvataggio riuscito</summary>
    private DateTime? ultimoSalvataggio = null;
    // v4.7: flag per animazione pulse sulla status bar dopo il salvataggio
    private bool statusBarLampeggia = false;

    /// <summary>Lista dei tipi ambienti di rilascio (per datalist)</summary>
    private List<TipoAmbienteRilascio> tipiAmbientiRilascio = new();

    /// <summary>True mentre è in corso l'autocompilazione degli ambienti di rilascio.</summary>
    private bool isCaricamentoAmbientiRilascio = false;

    /// <summary>Lista delle versioni di rilascio (per datalist)</summary>
    private List<VersioneRilascio> versioniRilascio = new();

    /// <summary>Lista dei tipi attività (caricata dal DB, usata nel dropdown)</summary>
    private List<TipoAttivitaItem> tipiAttivitaLista = new();

    /// <summary>Controlla la visibilità della modale editor tipi attività</summary>
    private bool mostraEditorTipiAttivita = false;

    /// <summary>Controlla la visibilità della modale calendario</summary>
    private bool mostraCalendario = false;

    /// <summary>Lista eventi imminenti (non risolti, entro finestra di avviso)</summary>
    private List<EventoCalendarioDto> eventiImminenti = new();

    // ===== Popup errore database =====
    /// <summary>Controlla la visibilità del popup di errore database</summary>
    private bool mostraPopupErroreDb = false;
    /// <summary>Messaggio da mostrare nel popup errore</summary>
    private string messaggioPopupErroreDb = string.Empty;

    // ===== Regex TODO con word boundary =====
    /// <summary>
    /// Regex per trovare TODO come parola isolata (non preceduta/seguita da lettera).
    /// Esclude occorrenze come "metodo" (che contiene "odo" ma non TODO come parola).
    /// </summary>
    private static readonly System.Text.RegularExpressions.Regex TodoRegex =
        new(@"(?<![a-zA-Z])TODO(?![a-zA-Z])",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    #endregion

    #region Lifecycle Methods

    /// <summary>
    /// Aggiorna i contenteditable div (changeset + note) dopo ogni render.
    /// Registra anche il callback Ctrl+S al primo render.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Registra il callback Ctrl+S
            dotNetRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("registraCtrlS", dotNetRef); }
            catch { /* Ignora se JS non ancora pronto */ }
        }

        if (changesetEditorNeedsUpdate && !changesetEditorFocused)
        {
            changesetEditorNeedsUpdate = false;
            try
            {
                await JS.InvokeVoidAsync("changesetEditorHelper.setContent",
                    changesetEditorRef,
                    AttivitaCorrente.ChangesetCoinvolti ?? "");
            }
            catch { /* Ignora errori JS (es: elemento non ancora presente) */ }
        }

        if (noteEditorNeedsUpdate && !noteEditorFocused)
        {
            noteEditorNeedsUpdate = false;
            try
            {
                await JS.InvokeVoidAsync("noteEditorHelper.setContent",
                    noteEditorRef,
                    AttivitaCorrente.Note ?? "");
            }
            catch { /* Ignora errori JS */ }
        }
    }

    /// <summary>
    /// Inizializzazione del componente.
    /// Carica l'utente corrente, i dati di lookup e imposta i filtri alla data odierna.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Copia di emergenza lasciata da un salvataggio fallito: va rilevata PRIMA di toccare il
        // database, così il banner compare anche quando il DB è ancora irraggiungibile.
        bozzaPresente = BozzaService.Esiste();
        dataBozza = BozzaService.DataBozza();

        try
        {
            // Carica utente corrente
            var utente = await UserService.GetOrCreateCurrentUserAsync();
            _utenteCorrenteId = utente.Id;
            utenteConnesso = string.IsNullOrEmpty(utente.NomeCompleto)
                ? utente.WindowsUsername
                : $"{utente.NomeCompleto} ({utente.WindowsUsername})";

            // Carica dati lookup
            clienti = await ActivityService.GetClientiAsync();
            ambienti = await ActivityService.GetAmbientiAsync();
            anniDisponibili = await ActivityService.GetAnniDisponibiliAsync(isAdminMode);
            tipiAmbientiRilascio = await AmbientiRilascioService.GetTipiAsync();
            versioniRilascio = await AmbientiRilascioService.GetVersioniAsync();

            // Assicura che i tipi base esistano e carica la lista
            await TipiAttivitaService.EnsureTipiBaseAsync();
            tipiAttivitaLista = await TipiAttivitaService.GetTipiAsync();

            // Carica eventi imminenti per la barra di avviso
            eventiImminenti = await CalendarioService.GetEventiImminentiAsync();

            // Carica conteggio TODO
            todoCount = await TodoService.GetTodoCountAsync();
            
            // Carica conteggio Appunti
            appuntiCount = await AppuntiService.GetAppuntiCountAsync();

            // Carica conteggio segnalazioni non risolte
            segnalazioniCount = await SegnalazioneService.GetSegnalazioniNonRisolteCountAsync();

            // Imposta Anno e Mese al mese corrente; Giorno rimane "Tutti"
            // così si visualizzano subito le attività del mese in corso
            var oggi = DateTime.Today;
            FiltroAnno = oggi.Year;
            FiltroMese = oggi.Month;
            // FiltroGiorno = null (default) → mostra tutte le attività del mese

            // Carica attività del mese corrente
            await CaricaAttivita();

            // Inizializza il form con i valori di default corretti (Sviluppo auto-selezionato)
            // Va chiamato dopo il caricamento dei dati per avere clienteSviluppoId valorizzato
            NuovaAttivita();

            // Avvia in background la pulizia dello storico modifiche (non blocca l'avvio)
            _ = PulisciStoricoEditorInBackground();

            // Converte a lotti le attività il cui testo ricercabile non è ancora stato calcolato
            _ = ConvertiTestoRicercabileInBackground();
        }
        catch (Exception ex)
        {
            MostraMessaggioConPopup($"Errore di connessione al database: {ex.Message}", true);
            isLoading = false;
        }
    }

    /// <summary>
    /// Ricarica nel form la bozza salvata su file da un precedente salvataggio fallito.
    /// Il file NON viene eliminato qui: sparisce solo dopo un salvataggio a DB riuscito,
    /// così un secondo tentativo andato male non lascia comunque l'utente senza rete.
    /// </summary>
    private void RipristinaBozza()
    {
        var bozza = BozzaService.Leggi();
        if (bozza == null)
        {
            MostraMessaggio("Impossibile leggere il file della bozza.", true);
            bozzaPresente = BozzaService.Esiste();
            return;
        }

        AttivitaCorrente = bozza;

        // Riallinea i due contenteditable al contenuto ripristinato (screenshot inclusi).
        changesetEditorNeedsUpdate = true;
        noteEditorNeedsUpdate = true;

        // Invalida l'anteprima del lavoro dei giorni precedenti: si riferisce all'attività di prima.
        mostraLavoroPrecedente = false;
        htmlLavoroPrecedente = string.Empty;
        lavoroPrecedenteCaricato = false;

        MostraMessaggio("Bozza ripristinata nel form. Premi 💾 Salva per scriverla nel database.", false);
    }

    /// <summary>
    /// Elimina il file della bozza senza ripristinarlo (l'utente non ne ha più bisogno).
    /// </summary>
    private void ScartaBozza()
    {
        BozzaService.Elimina();
        bozzaPresente = false;
        dataBozza = null;
        MostraMessaggio("Bozza eliminata.", false);
    }

    /// <summary>
    /// Chiamato da JavaScript quando l'utente preme Ctrl+S.
    /// </summary>
    [Microsoft.JSInterop.JSInvokable]
    public async Task SalvaViaShortcut()
    {
        await SalvaAttivita();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Rilascia le risorse al termine della vita del componente.
    /// </summary>
    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    #endregion

    #region Caricamento Dati

    /// <summary>
    /// Carica le attività dal database applicando i filtri correnti.
    /// In modalità admin, carica le attività di tutti gli utenti.
    /// </summary>
    private async Task CaricaAttivita()
    {
        try
        {
            isLoading = true;
            Attivita = await ActivityService.GetActivitiesAsync(
                FiltroAnno,
                FiltroMese,
                FiltroGiorno,
                string.IsNullOrWhiteSpace(TestoRicerca) ? null : TestoRicerca,
                isAdminMode,
                FiltroSettimana);
            
            // Applica filtro "Solo TODO" se attivo
            if (filtroSoloTodo)
            {
                Attivita = Attivita.Where(a => a.HasTodo).ToList();
            }

            // Filtro "Ticket in scadenza": oltre al TODO (già applicato sopra, la spunta è forzata)
            // tiene solo le attività con la scadenza valorizzata, dalla più vicina alla più lontana.
            if (filtroTicketInScadenza)
            {
                Attivita = Attivita
                    .Where(a => a.DataScadenzaTicket.HasValue)
                    .OrderBy(a => a.DataScadenzaTicket!.Value)
                    .ThenByDescending(a => a.Data)
                    .ToList();
            }
            
            anniDisponibili = await ActivityService.GetAnniDisponibiliAsync(isAdminMode);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore nel caricamento: {ex.Message}", true);
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Gestisce il cambio della modalità admin.
    /// Ricarica le attività per mostrare/nascondere quelle di altri utenti.
    /// </summary>
    private async Task OnAdminModeChanged()
    {
        await CaricaAttivita();
    }

    #endregion

    #region Gestione Selezione e Form

    /// <summary>
    /// Seleziona un'attività dalla griglia e popola il form con i suoi dati.
    /// Crea una copia per evitare modifiche dirette alla lista.
    /// </summary>
    private async Task SelezionaAttivita(WorkActivityDto attivita)
    {
        // La griglia carica i DTO in modalità leggera (senza Note/Changeset, campi pesanti):
        // quando si seleziona una riga esistente si ricarica il record completo dal DB.
        if (attivita.Id > 0)
        {
            var completo = await ActivityService.GetActivityByIdAsync(attivita.Id, isAdminMode);
            if (completo != null) attivita = completo;
        }

        AttivitaCorrente = new WorkActivityDto
        {
            Id = attivita.Id,
            Data = attivita.Data,
            TipoAttivita = attivita.TipoAttivita ?? TipiAttivita.Lavoro,
            Descrizione = attivita.Descrizione,
            UrlTicket = attivita.UrlTicket,
            NumeroTicket = attivita.NumeroTicket,
            DataScadenzaTicket = attivita.DataScadenzaTicket,
            ClienteId = attivita.ClienteId,
            ClienteNome = attivita.ClienteNome,
            OreLavorate = attivita.OreLavorate,
            Versione = attivita.Versione,
            AmbientiSelezionatiIds = new List<int>(attivita.AmbientiSelezionatiIds),
            Vedere = attivita.Vedere,
            Note = attivita.Note,
            ChangesetCoinvolti = attivita.ChangesetCoinvolti,
            UrlPatchRilasci = attivita.UrlPatchRilasci,
            TestoCheckIn = attivita.TestoCheckIn,
            CartellaDocumentazione = attivita.CartellaDocumentazione,
            UtenteId = attivita.UtenteId,
            UtenteUsername = attivita.UtenteUsername
        };

        // Carica le coppie ambiente/versione di rilascio (solo per attività esistenti)
        if (attivita.Id > 0)
        {
            try
            {
                AttivitaCorrente.AmbientiRilascio = await AmbientiRilascioService.GetAmbientiRilascioAsync(attivita.Id);
            }
            catch { /* Ignora errori: le coppie restano vuote */ }
        }

        // Reset della selezione "Sviluppo" nella tabella congelati
        // (Sviluppo non è salvato nel DB, quindi va sempre resettato)
        isSviluppoSelezionato = false;

        // Reset storico editor (nuova attività selezionata)
        _noteHistory = null;
        _noteHistoryIndex = -1;
        _noteContenutoSalvato = null;
        _changesetHistory = null;
        _changesetHistoryIndex = -1;
        _changesetContenutoSalvato = null;

        // Reset anteprima "lavoro dei giorni precedenti" (invalida anche la cache)
        mostraLavoroPrecedente = false;
        htmlLavoroPrecedente = string.Empty;
        lavoroPrecedenteCaricato = false;

        // Segnala che i due editor contenteditable devono essere aggiornati
        changesetEditorNeedsUpdate = true;
        noteEditorNeedsUpdate = true;
    }

    /// <summary>
    /// Resetta il form per inserire una nuova attività.
    /// Imposta la data odierna, la versione di sviluppo successiva e il cliente "Sviluppo" come default.
    /// </summary>
    private void NuovaAttivita()
    {
        var versioneSviluppo = CalcolaVersioneSviluppoSuccessiva();

        AttivitaCorrente = new WorkActivityDto
        {
            Data = DateTime.Today,
            TipoAttivita = TipiAttivita.Lavoro,
            Versione = versioneSviluppo,
            ClienteId = clienteSviluppoId  // Auto-seleziona "Sviluppo"
        };

        // Reset della selezione "Sviluppo" nella tabella congelati
        isSviluppoSelezionato = false;

        // Segnala aggiornamento editor changeset e note (svuota i div)
        changesetEditorNeedsUpdate = true;
        noteEditorNeedsUpdate = true;

        // Reset storico editor (nuova attività)
        _noteHistory = null;
        _noteHistoryIndex = -1;
        _noteContenutoSalvato = null;
        _changesetHistory = null;
        _changesetHistoryIndex = -1;
        _changesetContenutoSalvato = null;

        // Reset anteprima "lavoro dei giorni precedenti" (invalida anche la cache)
        mostraLavoroPrecedente = false;
        htmlLavoroPrecedente = string.Empty;
        lavoroPrecedenteCaricato = false;

        messaggio = string.Empty;
    }

    /// <summary>
    /// Placeholder dinamico per il campo "Versione di sviluppo": mostra la versione calcolata
    /// come suggerimento, oppure un esempio statico se non ci sono congelati.
    /// </summary>
    private string VersioneSviluppoPlaceholder
    {
        get
        {
            var v = CalcolaVersioneSviluppoSuccessiva();
            return string.IsNullOrEmpty(v) ? "Es: 3.2.61" : v;
        }
    }

    /// <summary>
    /// Calcola la versione di sviluppo successiva basandosi sulla prima versione dei congelati.
    /// Es: se la prima versione è 3.2.60, restituisce 3.2.61
    /// </summary>
    private string CalcolaVersioneSviluppoSuccessiva()
    {
        try
        {
            // Prende il primo ambiente (che ha la versione più alta grazie all'ordinamento)
            var primoAmbiente = ambienti.FirstOrDefault();
            if (primoAmbiente == null || string.IsNullOrEmpty(primoAmbiente.Descrizione))
                return string.Empty;

            // La descrizione è nel formato "X.Y.Z" (solo numeri)
            var descrizione = primoAmbiente.Descrizione;
            var match = System.Text.RegularExpressions.Regex.Match(descrizione, @"(\d+)\.(\d+)\.(\d+)");
            
            if (match.Success)
            {
                var major = int.Parse(match.Groups[1].Value);
                var minor = int.Parse(match.Groups[2].Value);
                var patch = int.Parse(match.Groups[3].Value);
                
                // Incrementa il patch di 1
                return $"{major}.{minor}.{patch + 1}";
            }
        }
        catch
        {
            // In caso di errore, restituisce stringa vuota
        }
        
        return string.Empty;
    }

    /// <summary>
    /// Annulla le modifiche correnti e resetta il form.
    /// </summary>
    private void AnnullaModifica()
    {
        NuovaAttivita();
    }

    /// <summary>
    /// Duplica un'attività esistente copiando tutti i campi tranne la data.
    /// Utile per inserire la stessa lavorazione per più giorni consecutivi.
    /// </summary>
    private async Task DuplicaAttivita(WorkActivityDto attivita)
    {
        // La griglia non carica Note/Changeset (campi pesanti): ricarica il record completo dal DB
        // prima di copiarne i contenuti, altrimenti la copia perderebbe Note e Changeset.
        if (attivita.Id > 0)
        {
            var completo = await ActivityService.GetActivityByIdAsync(attivita.Id, isAdminMode);
            if (completo != null) attivita = completo;
        }

        AttivitaCorrente = new WorkActivityDto
        {
            // ID = 0 per creare una NUOVA attività
            Id = 0,

            // Data odierna (NON copiata dall'originale)
            Data = DateTime.Today,

            // Copia tutti gli altri campi
            TipoAttivita = attivita.TipoAttivita ?? TipiAttivita.Lavoro,
            Descrizione = attivita.Descrizione,
            UrlTicket = attivita.UrlTicket,
            NumeroTicket = attivita.NumeroTicket,
            DataScadenzaTicket = attivita.DataScadenzaTicket,
            ClienteId = attivita.ClienteId,
            ClienteNome = attivita.ClienteNome,
            OreLavorate = attivita.OreLavorate,
            Versione = attivita.Versione,
            AmbientiSelezionatiIds = attivita.AmbientiSelezionatiIds?.ToList() ?? new List<int>(),
            Vedere = attivita.Vedere,
            // La Note NON viene copiata (eviterebbe di gonfiare il record su lavorazioni multi-giorno):
            // al suo posto un header "Proseguo l'attività" che fa da puntatore all'attività di origine.
            // Il contenuto dei giorni precedenti è ricostruibile col pulsante "Mostra la descrizione...".
            Note = GeneraHeaderProseguo(attivita),
            ChangesetCoinvolti = attivita.ChangesetCoinvolti,
            UrlPatchRilasci = attivita.UrlPatchRilasci,
            TestoCheckIn = attivita.TestoCheckIn,
            CartellaDocumentazione = attivita.CartellaDocumentazione
            // UtenteId e UtenteUsername NON copiati: verranno assegnati automaticamente al salvataggio
        };

        // Carica le coppie ambiente/versione di rilascio dal DB (la griglia non le ha)
        if (attivita.Id > 0)
        {
            try
            {
                AttivitaCorrente.AmbientiRilascio = (await AmbientiRilascioService.GetAmbientiRilascioAsync(attivita.Id))
                    .Select(a => new AmbienteRilascioDto
                    {
                        Posizione = a.Posizione,
                        TipoAmbiente = a.TipoAmbiente,
                        Versione = a.Versione
                    }).ToList();
            }
            catch { /* Ignora errori: le coppie restano vuote */ }
        }

        // Reset della selezione "Sviluppo" nella tabella congelati
        isSviluppoSelezionato = false;

        // Reset anteprima "lavoro dei giorni precedenti" (verrà ricostruita on-demand; invalida la cache)
        mostraLavoroPrecedente = false;
        htmlLavoroPrecedente = string.Empty;
        lavoroPrecedenteCaricato = false;

        // Segnala aggiornamento editor changeset e note
        changesetEditorNeedsUpdate = true;
        noteEditorNeedsUpdate = true;

        MostraMessaggio($"Attività duplicata! Modifica la data e salva.", false);
    }

    /// <summary>
    /// Genera l'header "Proseguo l'attività" da inserire nella Note della nuova attività duplicata.
    /// Fa da puntatore all'attività di origine (Id, Descrizione, NumeroTicket, Data).
    /// È testo semplice: setContent lo trasforma in HTML, HtmlToPlainText lo recupera per il parsing.
    /// </summary>
    private static string GeneraHeaderProseguo(WorkActivityDto origine)
    {
        var ticket = string.IsNullOrWhiteSpace(origine.NumeroTicket) ? "" : origine.NumeroTicket;
        return $"**** Proseguo l'attività {origine.Id}-{origine.Descrizione}-{ticket} del {origine.Data:dd/MM/yyyy} ****";
    }

    /// <summary>
    /// Indica se la Note dell'attività corrente contiene l'header "Proseguo l'attività",
    /// quindi se mostrare il pulsante per visualizzare il lavoro dei giorni precedenti.
    /// </summary>
    private bool NoteContieneProseguo()
    {
        var note = AttivitaCorrente?.Note;
        if (string.IsNullOrEmpty(note)) return false;
        return ProseguoRegex.IsMatch(HtmlToPlainText(note));
    }

    /// <summary>
    /// Mostra/nasconde l'anteprima readonly del lavoro svolto nei giorni precedenti.
    /// Alla PRIMA apertura ricostruisce la catena delle attività collegate dal DB e la memorizza
    /// (cache per-selezione); le aperture successive sono istantanee finché non si cambia attività.
    /// </summary>
    private async Task ToggleLavoroPrecedente()
    {
        // Se è già visibile, nascondi (la cache resta valida per una riapertura istantanea)
        if (mostraLavoroPrecedente)
        {
            mostraLavoroPrecedente = false;
            return;
        }

        // Cache: se già costruita per questa attività, riusa il risultato senza rileggere dal DB
        if (lavoroPrecedenteCaricato)
        {
            mostraLavoroPrecedente = true;
            return;
        }

        // Allinea la Note corrente al contenuto dell'editor (l'header è in cima e non cambia)
        try
        {
            var html = await JS.InvokeAsync<string>("noteEditorHelper.getHtml", noteEditorRef);
            if (!string.IsNullOrWhiteSpace(html)) AttivitaCorrente.Note = html;
        }
        catch { /* usa il valore già presente se la lettura JS fallisce */ }

        var catena = await CostruisciCatenaProseguo(AttivitaCorrente.Note);
        var ordinata = catena.OrderBy(a => a.Data).ToList();

        // Compone l'anteprima come HTML: l'intestazione "====== ... ======" (HtmlEncode per sicurezza)
        // seguita dalla Note in HTML (screenshot e formattazione preservati), togliendo la riga
        // "Proseguo" iniziale perché ridondante con l'intestazione.
        var sb = new System.Text.StringBuilder();
        foreach (var a in ordinata)
        {
            var ticket = string.IsNullOrWhiteSpace(a.NumeroTicket) ? "" : a.NumeroTicket;
            var intestazione = $"====== {a.Id}-{a.Descrizione}-{ticket} del {a.Data:dd/MM/yyyy} ======";
            sb.Append("<div style=\"font-weight:700; color:#0d6efd; margin-top:12px;\">");
            sb.Append(System.Net.WebUtility.HtmlEncode(intestazione));
            sb.Append("</div><div style=\"margin-bottom:16px;\">");
            sb.Append(RimuoviHeaderProseguoHtml(a.Note ?? string.Empty));
            sb.Append("</div>");
        }
        htmlLavoroPrecedente = sb.ToString();
        if (string.IsNullOrWhiteSpace(htmlLavoroPrecedente))
            htmlLavoroPrecedente = "<span class=\"text-muted\">(Nessuna attività precedente collegata trovata.)</span>";

        lavoroPrecedenteCaricato = true;   // cache valida fino al cambio attività
        mostraLavoroPrecedente = true;
    }

    /// <summary>
    /// Segue la catena delle attività collegate tramite l'header "Proseguo l'attività [Id]"
    /// presente nelle Note. Restituisce le attività precedenti (esclusa quella corrente),
    /// caricando per ciascuna la Note completa dal DB. Protetta contro i cicli.
    /// </summary>
    private async Task<List<WorkActivityDto>> CostruisciCatenaProseguo(string? notePartenza)
    {
        var risultato = new List<WorkActivityDto>();
        var visitati = new HashSet<int>();
        var noteCorrente = notePartenza;

        while (!string.IsNullOrEmpty(noteCorrente))
        {
            var match = ProseguoRegex.Match(HtmlToPlainText(noteCorrente));
            if (!match.Success) break;
            if (!int.TryParse(match.Groups[1].Value, out var id)) break;
            if (!visitati.Add(id) || visitati.Count > 500) break;   // anti-loop / limite di sicurezza

            var att = await ActivityService.GetActivityByIdAsync(id, isAdminMode);
            if (att == null) break;                                 // non trovata o di altro utente: stop
            risultato.Add(att);
            noteCorrente = att.Note;
        }
        return risultato;
    }

    /// <summary>
    /// Rimuove dall'HTML il prefisso dell'header "**** Proseguo l'attività ... ****"
    /// (ed eventuale separatore di riga successivo), preservando il resto dell'HTML — immagini incluse.
    /// La rimozione avviene solo se l'header è all'inizio (preceduto solo da tag/spazi), per non
    /// intaccare contenuto reale che contenesse per caso la frase "Proseguo l'attività".
    /// </summary>
    private static string RimuoviHeaderProseguoHtml(string html)
    {
        if (string.IsNullOrEmpty(html)) return html;
        var m = System.Text.RegularExpressions.Regex.Match(
            html,
            @"^(?:\s|<[^>]+>)*\*{2,}\s*Proseguo l'attività\b.*?\*{2,}\s*(?:</(?:div|p)>|<br\s*/?>)?",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase |
            System.Text.RegularExpressions.RegexOptions.Singleline);
        if (m.Success && m.Index == 0)
            return html.Substring(m.Length);
        return html;
    }

    /// <summary>
    /// Pulizia automatica dello storico modifiche (EditorHistory) all'avvio, in background.
    /// Elimina le voci più vecchie di NumeroMesiMantenimentoHistory mesi e, se ne elimina,
    /// mostra un avviso in testa al form che scompare automaticamente dopo qualche secondo.
    /// </summary>
    /// <summary>
    /// Popola a lotti `NoteTesto`/`ChangesetTesto` delle attività ancora da convertire (vedi
    /// `ActivityService.AggiornaTestoRicercabileAsync`). Gira in background, a lotti, con una pausa
    /// fra l'uno e l'altro: deve leggere i campi con gli screenshot, quindi non deve competere con
    /// l'uso normale del programma. Se l'applicazione viene chiusa a metà riprende al prossimo avvio.
    /// Durante la conversione la ricerca resta corretta perché ricade sulle colonne originali.
    /// </summary>
    private async Task ConvertiTestoRicercabileInBackground()
    {
        try
        {
            var daFare = await ActivityService.ContaDaConvertireAsync();
            if (daFare == 0) return;

            messaggioTestoRicercabile =
                $"Ottimizzazione della ricerca in corso: {daFare} attività da convertire. " +
                "Puoi continuare a lavorare, la ricerca funziona normalmente.";
            await InvokeAsync(StateHasChanged);

            var convertite = 0;
            while (true)
            {
                // Lotto volutamente piccolo: ogni riga porta con sé l'HTML con gli screenshot,
                // quindi 20 righe possono già essere diversi MB su una sola andata e ritorno.
                var n = await ActivityService.AggiornaTestoRicercabileAsync(20);
                if (n == 0) break;

                convertite += n;
                // Respiro fra un lotto e l'altro: l'ottimizzazione non deve rallentare l'uso normale.
                await Task.Delay(1500);
            }

            messaggioTestoRicercabile =
                $"Ottimizzazione della ricerca completata ({convertite} attività convertite).";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(12000);
            messaggioTestoRicercabile = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Un errore qui non deve disturbare: la ricerca continua a funzionare sulle colonne
            // originali e il lavoro riprende al prossimo avvio.
            messaggioTestoRicercabile = string.Empty;
        }
    }

    private async Task PulisciStoricoEditorInBackground()
    {
        try
        {
            var mesi = AppConfig.NumeroMesiMantenimentoHistory;
            if (mesi <= 0) return;

            var eliminati = await EditorHistoryService.EliminaVecchieAsync(mesi);
            if (eliminati > 0)
            {
                messaggioHistoryPulita =
                    $"L'History delle modifiche più vecchie di {mesi} mesi è stata eliminata. (Vedere il file appsetting per modificare questo automatismo)";
                await InvokeAsync(StateHasChanged);

                await Task.Delay(12000);
                messaggioHistoryPulita = string.Empty;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* non bloccare l'avvio per errori di pulizia storico */ }
    }

