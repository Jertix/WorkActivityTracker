        };
    }

    /// <summary>
    /// Determina la classe CSS per una riga della griglia.
    /// Gestisce sia la selezione che l'evidenziazione TODO.
    /// </summary>
    /// <summary>
    /// Classe CSS per l'evidenziazione della scadenza del ticket, in base ai giorni mancanti:
    /// già scaduta → rosso marcato, entro la soglia "rosso" → rosso, entro la soglia "arancione"
    /// → arancione chiaro. Soglie configurabili in appsettings.json (default 2 e 5 giorni).
    /// Una soglia <= 0 disattiva il relativo livello.
    /// </summary>
    private string GetClasseScadenza(DateTime? scadenza)
    {
        if (!scadenza.HasValue) return string.Empty;

        // Confronto per data (non per orario): oggi conta come 0 giorni mancanti.
        var giorniMancanti = (scadenza.Value.Date - DateTime.Today).Days;

        if (giorniMancanti < 0) return "scadenza-scaduta";
        if (giorniMancanti <= AppConfig.GiorniPreavvisoScadenzaRosso &&
            AppConfig.GiorniPreavvisoScadenzaRosso > 0) return "scadenza-rossa";
        if (giorniMancanti <= AppConfig.GiorniPreavvisoScadenzaArancione &&
            AppConfig.GiorniPreavvisoScadenzaArancione > 0) return "scadenza-arancione";

        return string.Empty;
    }

    private string GetRowClass(WorkActivityDto attivita)
    {
        var classes = new List<string>();

        // Riga selezionata (colore giallo vivace per distinguerla facilmente)
        if (AttivitaCorrente.Id == attivita.Id)
        {
            classes.Add("row-selected");
        }

        // Riga con TODO (sfondo rosso) — usa il flag calcolato lato DB (la griglia non carica le Note)
        if (attivita.HasTodo)
        {
            classes.Add("todo-row");
        }

        // Scadenza ticket vicina: sovrascrive il colore TODO (vedi app.css)
        var classeScadenza = GetClasseScadenza(attivita.DataScadenzaTicket);
        if (classeScadenza.Length > 0)
        {
            classes.Add(classeScadenza);
        }

        // Riga con zero ore (testo grigio in corsivo)
        if (attivita.OreLavorate == 0)
        {
            classes.Add("zero-ore-row");
        }

        return string.Join(" ", classes);
    }

