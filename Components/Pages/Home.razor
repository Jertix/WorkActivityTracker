    /// <summary>
    /// Cartella di destinazione degli export (creata se non esiste).
    /// Delega all'helper condiviso: la stessa cartella è usata dalle modali (es. Gestione Clienti).
    /// </summary>
    private string GetExportFolder() => AppConfigService.GetExportFolder();

    // ===== Stato "generazione export in corso" (rotellina) =====

    /// <summary>Etichetta dell'export in corso ("XLSX"/"TXT"/"PDF"); stringa vuota = nessun export.</summary>
    private string exportInCorso = string.Empty;

    /// <summary>Id della riga il cui export è in corso (0 = export non partito dalla griglia).</summary>
    private int exportRigaId;

    /// <summary>True mentre è in corso la generazione di un export.</summary>
    private bool IsExporting => exportInCorso.Length > 0;

    /// <summary>
    /// Esegue un export mostrando la rotellina accanto a "Apri Export" (e sul pulsante della riga,
    /// se l'export parte dalla griglia). Lo <c>StateHasChanged</c> + <c>Task.Delay(1)</c> iniziali
    /// servono a far comparire la rotellina PRIMA che inizi il lavoro pesante; il lavoro vero è poi
    /// spostato su un thread di background dai singoli metodi, così la rotellina continua a girare.
    /// Un export alla volta: i click successivi vengono ignorati.
    /// </summary>
    private async Task EseguiExportAsync(string etichetta, Func<Task> lavoro, int rigaId = 0)
    {
        if (IsExporting) return;

        exportInCorso = etichetta;
        exportRigaId = rigaId;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            await lavoro();
        }
        finally
        {
            exportInCorso = string.Empty;
            exportRigaId = 0;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Esporta la griglia visualizzata in formato Excel (.xlsx).
    /// </summary>
    private Task EsportaGrigliaXlsx() => EseguiExportAsync("XLSX", async () =>
    {
        try
        {
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var nomeFile = $"ElencoAttivitàAl{timestamp}.xlsx";
            var percorso = System.IO.Path.Combine(GetExportFolder(), nomeFile);

            // Snapshot dello stato UI: la generazione gira su un thread di background.
            var righe = Attivita.ToList();
            var admin = isAdminMode;

            await Task.Run(() =>
            {
                using var wb = new ClosedXML.Excel.XLWorkbook();
                var ws = wb.Worksheets.Add("Attività");

                // Intestazioni
                int col = 1;
                if (admin) ws.Cell(1, col++).Value = "Utente";
                ws.Cell(1, col++).Value = "Data";
                ws.Cell(1, col++).Value = "Tipo";
                ws.Cell(1, col++).Value = "Ticket";
                ws.Cell(1, col++).Value = "Descrizione";
                ws.Cell(1, col++).Value = "Cliente";
                ws.Cell(1, col++).Value = "Ore";
                ws.Cell(1, col++).Value = "Versione";

                // Stile intestazioni
                var headerRow = ws.Row(1);
                headerRow.Style.Font.Bold = true;
                headerRow.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.DarkGray;
                headerRow.Style.Font.FontColor = ClosedXML.Excel.XLColor.White;

                // Dati
                int row = 2;
                foreach (var att in righe)
                {
                    col = 1;
                    if (admin) ws.Cell(row, col++).Value = att.UtenteUsername;
                    ws.Cell(row, col).Style.NumberFormat.Format = "dd/MM/yyyy";
                    ws.Cell(row, col++).Value = att.Data;
                    ws.Cell(row, col++).Value = att.TipoAttivita;
                    ws.Cell(row, col++).Value = att.NumeroTicket ?? string.Empty;
                    ws.Cell(row, col++).Value = att.Descrizione;
                    ws.Cell(row, col++).Value = att.ClienteNome;
                    ws.Cell(row, col++).Value = att.OreLavorate;
                    ws.Cell(row, col++).Value = att.Versione;
                    row++;
                }

                ws.Columns().AdjustToContents();
                wb.SaveAs(percorso);
            });

            ultimoExport = percorso;
            MostraMessaggio($"Esportato: {nomeFile}", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore export XLSX: {ex.Message}", true);
        }
    });

    /// <summary>
    /// Esporta il dettaglio di tutte le attività visualizzate in un file TXT.
    /// </summary>
    private Task EsportaDettagliTxt() => EseguiExportAsync("TXT", async () =>
    {
        try
        {
            var dal = Attivita.Any() ? Attivita.Min(a => a.Data).ToString("yyyyMMdd") : "n_a";
            var al  = Attivita.Any() ? Attivita.Max(a => a.Data).ToString("yyyyMMdd") : "n_a";
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var nomeFile = $"DettaglioTutteLeAttività_{dal}_{al}_{timestamp}.txt";
            var percorso = System.IO.Path.Combine(GetExportFolder(), nomeFile);

            // La griglia è in modalità leggera (senza Note/Changeset): ricarica le stesse attività
            // in modalità completa (con i contenuti) usando i filtri correnti, così l'export è completo.
            var attivitaComplete = await ActivityService.GetActivitiesAsync(
                FiltroAnno, FiltroMese, FiltroGiorno,
                string.IsNullOrWhiteSpace(TestoRicerca) ? null : TestoRicerca,
                isAdminMode, FiltroSettimana, includeContenuto: true);
            if (filtroSoloTodo)
                attivitaComplete = attivitaComplete.Where(a => a.HasTodo).ToList();

            // Composizione del testo e scrittura su file: thread di background.
            await Task.Run(() =>
            {
                var sb = new System.Text.StringBuilder();
                bool primo = true;
                foreach (var att in attivitaComplete)
                {
                    if (!primo) sb.AppendLine(new string('=', 60));
                    sb.AppendLine(GeneraTestoAttivitaPlain(att));
                    primo = false;
                }

                System.IO.File.WriteAllText(percorso, sb.ToString(), System.Text.Encoding.UTF8);
            });

            ultimoExport = percorso;
            MostraMessaggio($"Esportato: {nomeFile}", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore export TXT: {ex.Message}", true);
        }
    });

    /// <summary>
    /// Esporta una singola attività come file TXT.
    /// </summary>
    private Task EsportaAttivitaComeTxt(WorkActivityDto att) => EseguiExportAsync("TXT", async () =>
    {
        try
        {
            // La griglia non carica Note/Changeset: ricarica il record completo per l'export.
            if (att.Id > 0)
            {
                var completo = await ActivityService.GetActivityByIdAsync(att.Id, isAdminMode);
                if (completo != null) att = completo;
            }

            var data = att.Data.ToString("yyyyMMdd");
            var desc = string.Concat((att.Descrizione ?? "").Take(40)
                .Where(c => !System.IO.Path.GetInvalidFileNameChars().Contains(c)));
            var timestamp = DateTime.Now.ToString("HHmmss");
            var nomeFile = $"DettaglioAttività_{data}_{desc}_{timestamp}.txt";
            var percorso = System.IO.Path.Combine(GetExportFolder(), nomeFile);

            var testo = GeneraTestoAttivitaPlain(att);
            await Task.Run(() => System.IO.File.WriteAllText(percorso, testo, System.Text.Encoding.UTF8));

            ultimoExport = percorso;
            MostraMessaggio($"Esportato: {nomeFile}", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore export TXT: {ex.Message}", true);
        }
    }, att.Id);

    /// <summary>
    /// Esporta una singola attività come file PDF (rende le immagini incollate nei campi HTML).
    /// </summary>
    private Task EsportaAttivitaComePdf(WorkActivityDto att) => EseguiExportAsync("PDF", async () =>
    {
        try
        {
            // La griglia non carica Note/Changeset: ricarica il record completo per l'export.
            if (att.Id > 0)
            {
                var completo = await ActivityService.GetActivityByIdAsync(att.Id, isAdminMode);
                if (completo != null) att = completo;
            }

            var data = att.Data.ToString("yyyyMMdd");
            var desc = string.Concat((att.Descrizione ?? "").Take(40)
                .Where(c => !System.IO.Path.GetInvalidFileNameChars().Contains(c)));
            var timestamp = DateTime.Now.ToString("HHmmss");
            var nomeFile = $"DettaglioAttività_{data}_{desc}_{timestamp}.pdf";
            var percorso = System.IO.Path.Combine(GetExportFolder(), nomeFile);

            // Attività collegate dalla catena "Proseguo l'attività": incluse solo se abilitato
            // in appsettings (EsportaAttivitaCollegateInPdf). Ordine cronologico crescente, così
            // il documento si legge come la progressione del lavoro fino all'attività esportata.
            var daEsportare = new List<WorkActivityDto> { att };
            int collegate = 0;
            if (AppConfig.EsportaAttivitaCollegateInPdf
                && !string.IsNullOrEmpty(att.Note)
                && ProseguoRegex.IsMatch(HtmlToPlainText(att.Note)))
            {
                var catena = await CostruisciCatenaProseguo(att.Note);
                collegate = catena.Count;
                if (collegate > 0)
                {
                    daEsportare = catena
                        .Concat(daEsportare)
                        .OrderBy(a => a.Data)
                        .ThenBy(a => a.Id)
                        .ToList();
                }
            }

            // Gli ambienti di rilascio non sono nel DTO dell'attività: vanno letti a parte
            // (una sola query per tutte le attività incluse nel documento).
            var ambientiPerAttivita = await AmbientiRilascioService.GetAmbientiRilascioBatchAsync(
                daEsportare.Select(a => a.Id));
            foreach (var a in daEsportare)
            {
                a.AmbientiRilascio = ambientiPerAttivita.TryGetValue(a.Id, out var coppie)
                    ? coppie
                    : new List<AmbienteRilascioDto>();
            }

            // Comporre l'HTML (immagini in base64) è la parte pesante: thread di background.
            // La stampa vera resta sul thread UI: WebView2 non è utilizzabile da altri thread.
            var html = await Task.Run(() => GeneraDocumentoHtml(daEsportare));
            await PdfExportService.ExportHtmlToPdfAsync(html, percorso);

            ultimoExport = percorso;
            MostraMessaggio(
                collegate > 0
                    ? $"Esportato: {nomeFile} (con {collegate} attività collegate)"
                    : $"Esportato: {nomeFile}",
                false);
        }
        catch (Exception ex)
        {
            SegnalaErrorePdf(ex);
        }
    }, att.Id);

    /// <summary>
    /// Mostra un messaggio d'errore PDF dettagliato (tipo, HResult, inner) e scrive lo
    /// stack completo su Export/pdf_error.log per diagnosi.
    /// </summary>
    private void SegnalaErrorePdf(Exception ex)
    {
        var msg = string.IsNullOrWhiteSpace(ex.Message) ? "(nessun messaggio)" : ex.Message;
        var inner = ex.InnerException != null ? $" | inner: {ex.InnerException.GetType().Name}: {ex.InnerException.Message}" : "";
        var testo = $"Errore export PDF: {ex.GetType().Name} (HRESULT 0x{ex.HResult:X8}) — {msg}{inner}";
        try
        {
            System.IO.File.WriteAllText(
                System.IO.Path.Combine(GetExportFolder(), "pdf_error.log"),
                $"{DateTime.Now:yyyy-MM-dd HH:mm:ss}\n{ex}", System.Text.Encoding.UTF8);
        }
        catch { /* best effort */ }
        MostraMessaggio(testo, true);
    }

    /// <summary>
