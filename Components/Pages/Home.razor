    // ===== Autoprepara struttura patch =====

    /// <summary>Radice cliente ({TmpPatchDir}\{Cliente}) dell'ultima struttura patch creata.</summary>
    private string? ultimaCartellaPatchClientRoot;

    /// <summary>
    /// Cartelle patch dell'ultimo "Autoprepara" (una per versione degli ambienti di rilascio).
    /// Sono quelle aperte — tutte — dal pulsante 📁.
    /// </summary>
    private List<string> ultimeCartellePatch = new();

    /// <summary>
    /// Nome cliente per la cartella patch: "Sviluppo" se è il cliente Sviluppo,
    /// altrimenti il nome del cliente selezionato.
    /// </summary>
    private string NomeClientePatch()
    {
        if (AttivitaCorrente.ClienteId == clienteSviluppoId)
            return "Sviluppo";
        return clienti.FirstOrDefault(c => c.Id == AttivitaCorrente.ClienteId)?.Nome ?? "Sviluppo";
    }

    /// <summary>
    /// Trasforma una versione "X.Y.Z" nel formato "X.Y_SP{Z}" (es. 3.2.61 → 3.2_SP61).
    /// Usa solo il primo token numerico (prima di spazi o parentesi), es. "4.1.10 (3.2.60)" → "4.1_SP10".
    /// Se il formato è inatteso restituisce il token grezzo.
    /// </summary>
    private static string FormatVersioneSP(string? versione)
    {
        if (string.IsNullOrWhiteSpace(versione)) return string.Empty;
        var token = versione.Trim().Split(new[] { ' ', '(' }, StringSplitOptions.RemoveEmptyEntries)[0];
        var idx = token.LastIndexOf('.');
        if (idx <= 0 || idx == token.Length - 1) return token; // formato inatteso: usa il token grezzo
        return $"{token[..idx]}_SP{token[(idx + 1)..]}";
    }

    /// <summary>
    /// Sanitizza un segmento per un nome di cartella: rimuove accenti/diacritici (es. Qualità → Qualita),
    /// spazi e caratteri non validi per un nome di file/cartella.
    /// </summary>
    private static string SanitizzaSegmentoCartella(string? s)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;

        // Rimuove gli accenti scomponendo i caratteri (FormD) e scartando i segni diacritici.
        var scomposto = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(scomposto.Length);
        foreach (var c in scomposto)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        var senzaAccenti = sb.ToString().Normalize(System.Text.NormalizationForm.FormC);

        // Rimuove spazi e caratteri non validi per un nome di cartella.
        var invalidi = System.IO.Path.GetInvalidFileNameChars();
        return string.Concat(senzaAccenti.Where(c => !char.IsWhiteSpace(c) && !invalidi.Contains(c)));
    }

    /// <summary>
    /// Percorsi calcolati per UNA cartella patch. Se gli ambienti di rilascio hanno versioni diverse
    /// viene prodotto un <see cref="PercorsoPatch"/> per ogni versione distinta.
    /// </summary>
    private sealed record PercorsoPatch(
        string ClientRoot,
        string Full,
        string Lingua,
        string ClienteNome,
        string VersioneRaw);

    /// <summary>
    /// Calcola (senza creare) i percorsi delle patch dallo stato corrente del form.
    /// Gli ambienti di rilascio con la STESSA versione vengono accorpati nella stessa cartella
    /// (nomi uniti da "_", es. "Test_Produzione"); ambienti con versioni DIVERSE generano
    /// cartelle separate, una per versione.
    /// </summary>
    private List<PercorsoPatch> CalcolaPercorsiPatch()
    {
        var isSviluppo = AttivitaCorrente.ClienteId == clienteSviluppoId;
        var clienteNome = NomeClientePatch();

        // Segmenti comuni a tutte le cartelle
        var dataSeg = DateTime.Now.ToString("yyyy-MM-dd");
        var nomeProgrammaSeg = SanitizzaSegmentoCartella(AppConfig.NomeProgramma);
        // TICKET (virgole → underscore)
        var ticketSeg = SanitizzaSegmentoCartella(
            (AttivitaCorrente.NumeroTicket ?? string.Empty).Replace(",", "_"));

        var clientRoot = System.IO.Path.Combine(AppConfig.TmpPatchDir, SanitizzaSegmentoCartella(clienteNome));

        // Lingua della struttura (dal cliente; "Sviluppo" e clienti senza valore → IT).
        var lingua = (clienti.FirstOrDefault(c => c.Id == AttivitaCorrente.ClienteId)?.Lingua ?? "IT")
            .Trim().ToUpperInvariant();

        // Gruppi (versione grezza, segmento ambienti): uno per ogni cartella da creare.
        var gruppi = new List<(string VersioneRaw, string AmbientiSeg)>();

        if (isSviluppo)
        {
            gruppi.Add((AttivitaCorrente.Versione ?? string.Empty, "Sviluppo"));
        }
        else
        {
            var coppie = AttivitaCorrente.AmbientiRilascio
                .Where(a => !string.IsNullOrWhiteSpace(a.TipoAmbiente))
                .Select(a => new
                {
                    Nome = SanitizzaSegmentoCartella(a.TipoAmbiente),
                    // Se la coppia non ha versione si usa quella dell'attività.
                    VersioneRaw = !string.IsNullOrWhiteSpace(a.Versione)
                        ? a.Versione!
                        : (AttivitaCorrente.Versione ?? string.Empty)
                })
                .Where(a => a.Nome.Length > 0)
                .ToList();

            if (coppie.Count == 0)
            {
                // Nessun ambiente compilato: una sola cartella senza segmento ambienti.
                gruppi.Add((AttivitaCorrente.Versione ?? string.Empty, string.Empty));
            }
            else
            {
                // Raggruppa per versione già normalizzata a segmento cartella (es. 3.2.50 → 3.2_SP50),
                // così due scritture equivalenti della stessa versione non creano cartelle doppie.
                foreach (var g in coppie.GroupBy(
                             c => SanitizzaSegmentoCartella(FormatVersioneSP(c.VersioneRaw)),
                             StringComparer.OrdinalIgnoreCase))
                {
                    gruppi.Add((g.First().VersioneRaw, string.Join("_", g.Select(x => x.Nome))));
                }
            }
        }

        var risultato = new List<PercorsoPatch>();
        foreach (var (versioneRaw, ambientiSeg) in gruppi)
        {
            var versioneSeg = SanitizzaSegmentoCartella(FormatVersioneSP(versioneRaw));

            // Nome cartella = segmenti non vuoti uniti da "_"
            var segmenti = new[] { dataSeg, nomeProgrammaSeg, versioneSeg, ambientiSeg, ticketSeg }
                .Where(s => !string.IsNullOrEmpty(s));
            var full = System.IO.Path.Combine(clientRoot, string.Join("_", segmenti));

            risultato.Add(new PercorsoPatch(clientRoot, full, lingua, clienteNome, versioneRaw));
        }

        return risultato;
    }

    /// <summary>
    /// Crea la struttura di cartelle della patch in TmpPatch:
    /// {TmpPatchDir}\{Cliente}\{AAAA-MM-GG}_{NOMEPROGRAMMA}_{VERSIONE}_{AMBIENTI}_{TICKET}\
    /// Se gli ambienti di rilascio hanno versioni diverse crea una cartella per ogni versione.
    /// </summary>
    private void AutopreparaStrutturaPatch()
    {
        try
        {
            var percorsi = CalcolaPercorsiPatch();
            var create = new List<string>();
            var esistenti = new List<string>();

            foreach (var p in percorsi)
            {
                // Se la cartella esiste già NON la ricrea né la tocca: si limita a segnalarlo.
                if (System.IO.Directory.Exists(p.Full))
                {
                    esistenti.Add(p.Full);
                    continue;
                }

                System.IO.Directory.CreateDirectory(p.Full);
                CreaStrutturaInternaPatch(p.Full, p.Lingua);
                create.Add(p.Full);
            }

            ultimaCartellaPatchClientRoot = percorsi.FirstOrDefault()?.ClientRoot;
            ultimeCartellePatch = percorsi.Select(x => x.Full).ToList();

            var parti = new List<string>();
            if (create.Count > 0)
                parti.Add($"create {create.Count}: {string.Join(" | ", create)}");
            if (esistenti.Count > 0)
                parti.Add($"già esistenti {esistenti.Count} (nessuna modifica): {string.Join(" | ", esistenti)}");

            MostraMessaggio($"Struttura patch — {string.Join(" — ", parti)}", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore creazione struttura patch: {ex.Message}", true);
        }
    }

    /// <summary>
    /// Crea la struttura interna di sottocartelle (tutte in MAIUSCOLO) dentro la cartella patch,
    /// con i nomi nella lingua indicata ("IT" o "EN"):
    ///   00_PREREQUISITI / 00_PREREQUISITES
    ///   01_{NOMEPROGRAMMA}\01_DATABASE_SERVER
    ///                      \02_APPLICATION_SERVER\01_COMPONENTI_SERVER / 01_SERVER_COMPONENTS
    ///                                            \02_SETUP_WEB
    ///                      \03_CLIENT
    /// </summary>
    private void CreaStrutturaInternaPatch(string radice, string lingua)
    {
        var isEn = string.Equals(lingua, "EN", StringComparison.OrdinalIgnoreCase);
        var nomeProgramma = SanitizzaSegmentoCartella(AppConfig.NomeProgramma).ToUpperInvariant();

        // Nomi che cambiano in base alla lingua
        var prerequisiti = isEn ? "00_PREREQUISITES" : "00_PREREQUISITI";
        var componentiServer = isEn ? "01_SERVER_COMPONENTS" : "01_COMPONENTI_SERVER";

        System.IO.Directory.CreateDirectory(System.IO.Path.Combine(radice, prerequisiti));

        // 01_{NOMEPROGRAMMA} e relative sottocartelle
        var prog = System.IO.Path.Combine(radice, $"01_{nomeProgramma}");
        System.IO.Directory.CreateDirectory(System.IO.Path.Combine(prog, "01_DATABASE_SERVER"));

        var appServer = System.IO.Path.Combine(prog, "02_APPLICATION_SERVER");
        System.IO.Directory.CreateDirectory(System.IO.Path.Combine(appServer, componentiServer));
        System.IO.Directory.CreateDirectory(System.IO.Path.Combine(appServer, "02_SETUP_WEB"));

        System.IO.Directory.CreateDirectory(System.IO.Path.Combine(prog, "03_CLIENT"));
    }

    // ===== Inserimento file Readme =====

    /// <summary>Visibilità della popup di inserimento readme.</summary>
    private bool mostraReadmeModal = false;
    /// <summary>Template filtrati per la lingua del cliente, mostrati nella popup.</summary>
    private List<ReadmeTemplate> readmeTemplatesFiltrati = new();
    /// <summary>
    /// Titoli originali (con i token ancora da sostituire) allineati per indice a
    /// <see cref="readmeTemplatesFiltrati"/>: servono a risolvere {VERSIONE} per ogni cartella patch,
    /// dato che con più versioni il titolo può differire da cartella a cartella.
    /// </summary>
    private List<string> readmeTitoliOriginali = new();

    /// <summary>
    /// Apre la popup di inserimento readme. Richiede che almeno una cartella patch sia già stata
    /// creata con "Autoprepara struttura patch".
    /// </summary>
    private void ApriInserisciReadme()
    {
        try
        {
            var percorsi = CalcolaPercorsiPatch();
            var esistenti = percorsi.Where(p => System.IO.Directory.Exists(p.Full)).ToList();
            if (esistenti.Count == 0)
            {
                MostraMessaggio("Premi prima 'Autoprepara struttura patch'.", true);
                return;
            }

            var lingua = esistenti[0].Lingua;

            readmeTemplatesFiltrati = ReadmeTemplateService.GetTemplates()
                .Where(t => string.Equals(t.Lingua?.Trim(), lingua, StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (readmeTemplatesFiltrati.Count == 0)
            {
                MostraMessaggio($"Nessun template Readme disponibile per la lingua '{lingua}'.", true);
                return;
            }

            // Conserva i titoli grezzi, poi sostituisce i token per la label mostrata nella popup
            // (usa la prima versione: nei file il titolo viene ricalcolato per ogni cartella).
            readmeTitoliOriginali = readmeTemplatesFiltrati.Select(t => t.Titolo).ToList();
            foreach (var t in readmeTemplatesFiltrati)
                t.Titolo = SostituisciTokenTesto(t.Titolo, esistenti[0].ClienteNome, esistenti[0].VersioneRaw);

            mostraReadmeModal = true;
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore apertura Readme: {ex.Message}", true);
        }
    }

    private void ChiudiReadmeModal() => mostraReadmeModal = false;

    /// <summary>
    /// Scrive i file .txt per i template selezionati in TUTTE le strutture patch esistenti
    /// (una per versione degli ambienti di rilascio). I file già presenti non vengono sovrascritti.
    /// Sostituisce i token nel testo, nel titolo e nel percorso di destinazione.
    /// </summary>
    private void OnInserisciReadme(List<ReadmeTemplate> scelti)
    {
        try
        {
            var percorsi = CalcolaPercorsiPatch()
                .Where(p => System.IO.Directory.Exists(p.Full))
                .ToList();

            if (percorsi.Count == 0)
            {
                MostraMessaggio("Premi prima 'Autoprepara struttura patch'.", true);
                mostraReadmeModal = false;
                return;
            }

            // Raggruppa i readme selezionati per cartella di destinazione (path risolto).
            // In ogni cartella viene creato un unico Readme.txt con le sezioni dei vari readme.
            var gruppi = scelti.GroupBy(
                    t => SostituisciTokenPercorso(t.DirectoryDiSalvataggio) ?? string.Empty,
                    StringComparer.OrdinalIgnoreCase)
                .ToList();

            var sep = new string('=', 60);
            int creati = 0, saltati = 0;

            // Gli stessi readme vengono scritti in ogni struttura patch creata.
            foreach (var p in percorsi)
            {
                foreach (var g in gruppi)
                {
                    var dir = System.IO.Path.Combine(p.Full, g.Key);
                    var percorso = System.IO.Path.Combine(dir, "Readme.txt");

                    // Se il Readme.txt esiste già NON viene toccato.
                    if (System.IO.File.Exists(percorso))
                    {
                        saltati++;
                        continue;
                    }

                    var sb = new System.Text.StringBuilder();
                    var primo = true;
                    foreach (var t in g)
                    {
                        if (!primo) sb.AppendLine().AppendLine();
                        // Titolo e testo risolti con la versione DI QUESTA cartella patch.
                        var idx = readmeTemplatesFiltrati.IndexOf(t);
                        var titoloRaw = idx >= 0 && idx < readmeTitoliOriginali.Count
                            ? readmeTitoliOriginali[idx]
                            : t.Titolo;
                        var titolo = SostituisciTokenTesto(titoloRaw, p.ClienteNome, p.VersioneRaw);
                        var contenuto = SostituisciTokenTesto(t.Descrizione, p.ClienteNome, p.VersioneRaw);
                        sb.AppendLine(sep);
                        sb.AppendLine(titolo);
                        sb.AppendLine(sep);
                        sb.AppendLine();
                        sb.AppendLine(contenuto);
                        primo = false;
                    }

                    System.IO.Directory.CreateDirectory(dir);
                    var testo = sb.ToString().Replace("\r\n", "\n").Replace("\n", Environment.NewLine);
                    System.IO.File.WriteAllText(percorso, testo, System.Text.Encoding.UTF8);
                    creati++;
                }
            }

            mostraReadmeModal = false;
            MostraMessaggio(
                $"Readme.txt in {percorsi.Count} struttura/e patch: {creati} creati, {saltati} già presenti (saltati).",
                false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore inserimento Readme: {ex.Message}", true);
        }
    }

    /// <summary>Sostituisce i token nel testo del readme.</summary>
    private string SostituisciTokenTesto(string testo, string clienteNome, string versioneRaw)
    {
        if (string.IsNullOrEmpty(testo)) return string.Empty;
        return testo
            .Replace("{NOMEPROGRAMMA}", AppConfig.NomeProgramma)
            .Replace("{NOMECOMPAGNIA}", AppConfig.NomeCompagnia)
            .Replace("{CLIENTE}", clienteNome)
            .Replace("{VERSIONE}", versioneRaw);
    }

    /// <summary>Sostituisce i token in un percorso di destinazione ({NOMEPROGRAMMA} in forma cartella MAIUSCOLA).</summary>
    private string SostituisciTokenPercorso(string percorso)
    {
        if (string.IsNullOrEmpty(percorso)) return string.Empty;
        var progFolder = SanitizzaSegmentoCartella(AppConfig.NomeProgramma).ToUpperInvariant();
        return percorso
            .Replace("{NOMEPROGRAMMA}", progFolder)
            .Replace("{NOMECOMPAGNIA}", AppConfig.NomeCompagnia);
    }

    /// <summary>
    /// Apre in Esplora Risorse TUTTE le cartelle patch (una finestra per versione): quelle dell'ultimo
    /// "Autoprepara" o, se mancano, quelle calcolate dallo stato corrente del form che esistono su disco.
    /// Se nessuna cartella patch esiste, ripiega sulla cartella cliente.
    /// </summary>
    private void ApriCartellaPatch()
    {
        try
        {
            // 1) le cartelle create dall'ultimo Autoprepara, se esistono ancora
            var target = ultimeCartellePatch
                .Where(System.IO.Directory.Exists)
                .ToList();

            // 2) altrimenti le cartelle patch calcolate dal form che esistono su disco
            if (target.Count == 0)
                target = CalcolaPercorsiPatch()
                    .Select(p => p.Full)
                    .Where(System.IO.Directory.Exists)
                    .ToList();

            // 3) come ultima spiaggia la cartella cliente (creata se manca)
            if (target.Count == 0)
            {
                var clientRoot = !string.IsNullOrEmpty(ultimaCartellaPatchClientRoot)
                    ? ultimaCartellaPatchClientRoot!
                    : System.IO.Path.Combine(AppConfig.TmpPatchDir, SanitizzaSegmentoCartella(NomeClientePatch()));
                System.IO.Directory.CreateDirectory(clientRoot);
                target.Add(clientRoot);
            }

            // Una finestra di Esplora Risorse per ogni cartella (percorso tra virgolette: può contenere spazi).
            foreach (var cartella in target.Distinct(StringComparer.OrdinalIgnoreCase))
            {
                Process.Start(new ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"\"{cartella}\"",
                    UseShellExecute = true
                });
            }
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore apertura cartella patch: {ex.Message}", true);
        }
    }

    /// <summary>
    /// Compone le coppie "Ambiente — Versione" di un'attività, una per riga (CampoPlain converte
    /// i "\n" in &lt;br&gt;). Restituisce stringa vuota se non ci sono ambienti compilati.
    /// </summary>
    private static string FormattaAmbientiRilascio(WorkActivityDto att)
    {
        if (att.AmbientiRilascio == null) return string.Empty;

        var righe = att.AmbientiRilascio
            .Where(c => !string.IsNullOrWhiteSpace(c.TipoAmbiente) || !string.IsNullOrWhiteSpace(c.Versione))
            .OrderBy(c => c.Posizione)
            .Select(c => string.Join(" — ", new[] { c.TipoAmbiente, c.Versione }
                .Where(x => !string.IsNullOrWhiteSpace(x))));

        return string.Join("\n", righe);
    }

