    /// <summary>
    /// Salva l'attività corrente (nuova o modifica).
    /// Esegue validazione prima del salvataggio.
    /// </summary>
    private async Task SalvaAttivita()
    {
        if (string.IsNullOrWhiteSpace(AttivitaCorrente.Descrizione))
        {
            MostraMessaggio("La descrizione è obbligatoria", true);
            return;
        }

        // Legge HTML dal contenteditable Note prima di salvare
        try
        {
            var htmlNote = await JS.InvokeAsync<string>("noteEditorHelper.getHtml", noteEditorRef);
            AttivitaCorrente.Note = string.IsNullOrWhiteSpace(htmlNote) ? null : htmlNote;
        }
        catch { /* Usa il valore già presente se la lettura JS fallisce */ }

        // Legge HTML dal contenteditable Changeset prima di salvare
        if (AttivitaCorrente.TipoAttivita == TipiAttivita.Lavoro)
        {
            try
            {
                var htmlChangeset = await JS.InvokeAsync<string>("changesetEditorHelper.getHtml", changesetEditorRef);
                AttivitaCorrente.ChangesetCoinvolti = string.IsNullOrWhiteSpace(htmlChangeset) ? null : htmlChangeset;
            }
            catch { /* Usa il valore già presente se la lettura JS fallisce */ }
        }

        try
        {
            isSaving = true;
            int savedId;

            if (IsModifica)
            {
                savedId = AttivitaCorrente.Id;
                await ActivityService.UpdateActivityAsync(AttivitaCorrente);
                MostraMessaggio("Attività aggiornata con successo!", false);
            }
            else
            {
                var saved = await ActivityService.AddActivityAsync(AttivitaCorrente);
                savedId = saved.Id;
                MostraMessaggio("Attività salvata con successo!", false);
            }

            // Salvataggio riuscito: la copia di emergenza su file non serve più.
            BozzaService.Elimina();
            bozzaPresente = false;
            dataBozza = null;

            // Registra l'orario dell'ultimo salvataggio (mostrato nella barra di stato)
            ultimoSalvataggio = DateTime.Now;

            // v4.9: feedback visivo — lampeggio verde sulla status bar per 4s
            statusBarLampeggia = true;
            _ = Task.Run(async () =>
            {
                await Task.Delay(4000);
                await InvokeAsync(() =>
                {
                    statusBarLampeggia = false;
                    StateHasChanged();
                });
            });

            // Salva lo storico versioni per Note e ChangesetCoinvolti (solo se non vuoti e diversi dall'ultimo salvataggio)
            try
            {
                var noteHtml = AttivitaCorrente.Note;
                if (!string.IsNullOrWhiteSpace(HtmlToPlainText(noteHtml ?? "")))
                {
                    var ultimoNote = await EditorHistoryService.GetUltimoContenutoAsync(savedId, "Note");
                    if (ultimoNote != noteHtml)
                    {
                        await EditorHistoryService.SalvaAsync(
                            savedId, _utenteCorrenteId, "Note",
                            noteHtml, ultimoSalvataggio.Value);
                    }
                }

                if (AttivitaCorrente.TipoAttivita == TipiAttivita.Lavoro
                    && !string.IsNullOrWhiteSpace(HtmlToPlainText(AttivitaCorrente.ChangesetCoinvolti ?? "")))
                {
                    var ultimoChangeset = await EditorHistoryService.GetUltimoContenutoAsync(savedId, "ChangesetCoinvolti");
                    if (ultimoChangeset != AttivitaCorrente.ChangesetCoinvolti)
                    {
                        await EditorHistoryService.SalvaAsync(
                            savedId, _utenteCorrenteId, "ChangesetCoinvolti",
                            AttivitaCorrente.ChangesetCoinvolti, ultimoSalvataggio.Value);
                    }
                }
            }
            catch { /* Ignora errori sullo storico: non compromette il salvataggio principale */ }

            // Ricarica i datalist ambienti/versioni (potrebbero essere stati aggiunti nuovi valori)
            tipiAmbientiRilascio = await AmbientiRilascioService.GetTipiAsync();
            versioniRilascio = await AmbientiRilascioService.GetVersioniAsync();

            await CaricaAttivita();

            // Dopo il salvataggio, riseleziona l'attività appena salvata
            var attivitaSalvata = Attivita.FirstOrDefault(a => a.Id == savedId);
            if (attivitaSalvata != null)
            {
                await SelezionaAttivita(attivitaSalvata);
            }
            else
            {
                // Se non è visibile con i filtri correnti, resetta il form
                NuovaAttivita();
            }
        }
        catch (Exception ex)
        {
            // DB irraggiungibile (tipicamente VPN caduta): mette al sicuro su file il contenuto
            // del form, screenshot inclusi. Il file viene cancellato al primo salvataggio riuscito.
            var percorsoBozza = BozzaService.Salva(AttivitaCorrente);
            bozzaPresente = percorsoBozza != null;
            dataBozza = BozzaService.DataBozza();

            var avviso = percorsoBozza != null
                ? $"\n\nLe modifiche NON sono andate perse: sono state salvate in {percorsoBozza}. "
                  + "Quando la connessione torna ripremi 💾 Salva: al salvataggio riuscito il file verrà eliminato."
                : "\n\nATTENZIONE: non è stato possibile scrivere nemmeno la copia di emergenza su file. "
                  + "Non chiudere il programma finché il salvataggio non riesce.";

            MostraMessaggioConPopup($"Errore nel salvataggio: {ex.Message}{avviso}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    /// <summary>
    /// Elimina un'attività dal database.
    /// </summary>
    /// <summary>
    /// Mostra la modale di conferma prima di eliminare l'attività.
    /// </summary>
    private void ConfermaEliminaAttivita(WorkActivityDto attivita)
    {
        attivitaDaEliminare = attivita;
        mostraConfermaElimina = true;
    }

    /// <summary>
    /// Eseguita quando l'utente conferma l'eliminazione nella modale.
    /// </summary>
    private async Task ConfermaElimina()
    {
        mostraConfermaElimina = false;
        if (attivitaDaEliminare != null)
        {
            await EliminaAttivita(attivitaDaEliminare.Id);
            attivitaDaEliminare = null;
        }
    }

    /// <summary>
    /// Eseguita quando l'utente annulla l'eliminazione nella modale.
    /// </summary>
    private void AnnullaElimina()
    {
        mostraConfermaElimina = false;
        attivitaDaEliminare = null;
    }

    private async Task EliminaAttivita(int id)
    {
        try
        {
            await ActivityService.DeleteActivityAsync(id);
            await CaricaAttivita();

            if (AttivitaCorrente.Id == id)
                NuovaAttivita();

            MostraMessaggio("Attività eliminata", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore nell'eliminazione: {ex.Message}", true);
        }
    }

