@using WorkActivityTracker.Models
@using WorkActivityTracker.Services
@inject SoftwareService SoftwareService

@*
    Componente modale per la gestione della lista dei software (v5.6).
    Lista CONDIVISA fra tutti gli utenti, con log di ogni modifica (Software_Log).
    Il software di default (NomeProgramma di appsettings) non può essere rinominato né disattivato:
    all'avvio verrebbe comunque ricreato/riattivato.
*@

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-scrollable modal-lg" style="max-width: 70%;">
            <div class="modal-content" style="height: 75vh;">

                @* ===== HEADER ===== *@
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">💻 Gestione Software</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Chiudi"></button>
                </div>

                @* ===== BODY ===== *@
                <div class="modal-body" style="overflow-y: auto;">

                    <div class="alert alert-info py-2 mb-3 small">
                        ⚠️ La lista dei software è <strong>condivisa</strong> fra tutti gli utenti del programma: le modifiche sono visibili a tutti e vengono registrate nel log.
                    </div>

                    @if (!string.IsNullOrEmpty(messaggio))
                    {
                        <div class="alert @(isErrore ? "alert-danger" : "alert-success") alert-dismissible py-2" role="alert">
                            @messaggio
                            <button type="button" class="btn-close" @onclick="() => messaggio = string.Empty"></button>
                        </div>
                    }

                    @* ===== GRIGLIA SOFTWARE ===== *@
                    <div class="card mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong>Software (@lista.Count elementi)</strong>
                            @if (isLoading)
                            {
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Caricamento...</span>
                                </div>
                            }
                        </div>
                        <div class="card-body p-0">
                            <div style="max-height: 280px; overflow-y: auto;">
                                <table class="table table-hover table-striped mb-0">
                                    <thead class="table-dark sticky-top">
                                        <tr>
                                            <th style="width: 60px;">Ordine</th>
                                            <th>Nome</th>
                                            <th style="width: 80px;">Attivo</th>
                                            <th style="width: 80px;">Default</th>
                                            <th style="width: 80px;">Azioni</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (lista.Any())
                                        {
                                            @foreach (var sw in lista)
                                            {
                                                <tr @onclick="() => Seleziona(sw)"
                                                    class="@(corrente.Id == sw.Id ? "table-active" : "")"
                                                    style="cursor: pointer;">
                                                    <td class="text-muted">@sw.Ordine</td>
                                                    <td class="@(!sw.Attivo ? "text-muted text-decoration-line-through" : "fw-bold")">
                                                        @sw.Nome
                                                    </td>
                                                    <td>
                                                        @if (sw.Attivo)
                                                        {
                                                            <span class="badge bg-success">Sì</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">No</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (IsDefault(sw.Nome))
                                                        {
                                                            <span class="badge bg-primary" title="Valore di NomeProgramma in appsettings.json">Default</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!IsDefault(sw.Nome) && sw.Attivo)
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                    @onclick="() => Disattiva(sw.Id)"
                                                                    @onclick:stopPropagation="true"
                                                                    title="Disattiva software (le attività che lo usano continuano a mostrarlo)">
                                                                🗑️
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-4">
                                                    Nessun software presente.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @* ===== FORM DETTAGLIO/INSERIMENTO ===== *@
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong>@(IsModifica ? "📝 Modifica Software" : "➕ Nuovo Software")</strong>
                            @if (corrente.Id > 0)
                            {
                                <span class="badge bg-primary">ID: @corrente.Id</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Nome <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control"
                                           @bind="corrente.Nome"
                                           maxlength="100"
                                           placeholder="Nome del software"
                                           disabled="@CorrenteIsDefault" />
                                    @if (CorrenteIsDefault)
                                    {
                                        <small class="text-muted">Il software di default si cambia da <code>NomeProgramma</code> in appsettings.json.</small>
                                    }
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Ordine</label>
                                    <input type="number" class="form-control"
                                           @bind="corrente.Ordine" min="1" max="99" />
                                    <small class="text-muted">Posizione nel dropdown (1 = primo)</small>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Attivo</label>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox"
                                               id="softwareAttivo"
                                               @bind="corrente.Attivo"
                                               disabled="@CorrenteIsDefault" />
                                        <label class="form-check-label" for="softwareAttivo">
                                            Attivo
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <button class="btn btn-success btn-sm" @onclick="Salva" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                💾 Salva
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="Nuovo">
                                ➕ Nuovo
                            </button>
                        </div>
                    </div>

                </div>

                @* ===== FOOTER ===== *@
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Chiudi">Chiudi</button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnChiudi { get; set; }
    [Parameter] public EventCallback OnSoftwareChanged { get; set; }

    /// <summary>Nome del software di default (NomeProgramma di appsettings).</summary>
    [Parameter] public string NomeDefault { get; set; } = string.Empty;

    private List<SoftwareItem> lista = new();
    private SoftwareItem corrente = new();
    private bool isLoading = false;
    private bool isSaving = false;
    private string messaggio = string.Empty;
    private bool isErrore = false;

    private bool IsModifica => corrente.Id > 0;

    private bool IsDefault(string nome) =>
        !string.IsNullOrWhiteSpace(NomeDefault) &&
        string.Equals(nome?.Trim(), NomeDefault.Trim(), StringComparison.OrdinalIgnoreCase);

    // Il default si riconosce sul record SALVATO, non sul testo che si sta digitando:
    // altrimenti scrivendo il nome di default in un nuovo record il campo si bloccherebbe.
    private bool CorrenteIsDefault =>
        IsModifica && lista.Any(s => s.Id == corrente.Id && IsDefault(s.Nome));

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !lista.Any())
            await Carica();
    }

    private async Task Carica()
    {
        isLoading = true;
        try
        {
            lista = await SoftwareService.GetTuttiAsync();
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore nel caricamento: {ex.Message}", true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Seleziona(SoftwareItem sw)
    {
        corrente = new SoftwareItem
        {
            Id = sw.Id,
            Nome = sw.Nome,
            Ordine = sw.Ordine,
            Attivo = sw.Attivo
        };
    }

    private void Nuovo()
    {
        corrente = new SoftwareItem { Ordine = 99, Attivo = true };
        messaggio = string.Empty;
    }

    private async Task Salva()
    {
        if (string.IsNullOrWhiteSpace(corrente.Nome))
        {
            MostraMessaggio("Il nome è obbligatorio", true);
            return;
        }

        isSaving = true;
        try
        {
            if (IsModifica)
            {
                await SoftwareService.UpdateAsync(corrente);
                MostraMessaggio("Software aggiornato con successo!", false);
            }
            else
            {
                await SoftwareService.AddAsync(corrente);
                MostraMessaggio("Software aggiunto con successo!", false);
            }

            await Carica();
            await OnSoftwareChanged.InvokeAsync();
            corrente = new SoftwareItem { Ordine = 99, Attivo = true };
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore: {ex.Message}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Disattiva(int id)
    {
        try
        {
            await SoftwareService.DisattivaAsync(id);
            await Carica();
            await OnSoftwareChanged.InvokeAsync();
            MostraMessaggio("Software disattivato.", false);
            if (corrente.Id == id)
                Nuovo();
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore: {ex.Message}", true);
        }
    }

    private async Task Chiudi()
    {
        lista.Clear();
        Nuovo();
        await OnChiudi.InvokeAsync();
    }

    private void MostraMessaggio(string testo, bool errore)
    {
        messaggio = testo;
        isErrore = errore;
    }
}
