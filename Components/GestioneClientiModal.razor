                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="AnnullaElimina">Annulla</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfermaElimina">🗑️ Elimina</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    #region Parameters

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnChiudi { get; set; }

    #endregion

    #region Fields

    private List<ClienteAmbienteDto> righe = new();
    private List<ClienteDto> clienti = new();
    private List<string> ambientiDistinti = new();
    private List<AmbienteDto> congelatiAttivi = new();
    private ClienteAmbienteDto corrente = new();

    private bool lampeggiaSalvataggio = false;
    private DateTime? ultimoSalvataggioModal;

    private IEnumerable<string> NumeriVersioneSuggeriti => corrente.TipoVersione switch
    {
        "Versione" => congelatiAttivi.Select(a => a.Descrizione).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!).Distinct(),
        "Versione4" => congelatiAttivi.Select(a => a.Descrizione4).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!).Distinct(),
        "Versione5" => congelatiAttivi.Select(a => a.Descrizione5).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!).Distinct(),
        _ => Enumerable.Empty<string>()
    };

    private static string TipoVersionePrefix(string? tipo) => tipo switch
    {
        "Versione" => "V",
        "Versione4" => "V4",
        "Versione5" => "V5",
        _ => string.Empty
    };

    private ElementReference collegamentoEditorRef;
    private bool collegamentoEditorNeedsUpdate = false;

    private ElementReference datiAmbienteEditorRef;
    private bool datiAmbienteEditorNeedsUpdate = false;

    private DotNetObjectReference<GestioneClientiModal>? _dotNetRef;

    private bool isLoading = false;
    private bool isSaving = false;

    // Lista in memoria fra un'apertura e l'altra: la modale resta nel render tree di Home
    // (cambia solo IsVisible), quindi "righe" sopravvive alla chiusura. Dalla seconda apertura
    // la griglia si mostra subito e viene aggiornata dietro le quinte.
    private bool listaCaricata = false;
    private bool isAggiornamento = false;

    // Contatore dei caricamenti: se ne parte uno nuovo (es. Salva durante l'aggiornamento in
    // background) il risultato di quello vecchio viene scartato, altrimenti potrebbe arrivare
    // dopo e rimettere in griglia dati precedenti al salvataggio.
    private int _generazioneCaricamento = 0;
    private bool _disposed = false;
    private string messaggio = string.Empty;
    private bool isErrore = false;

    private bool mostraConfermaElimina = false;
    private ClienteAmbienteDto? daEliminare;

    private bool _wasVisible = false;

    private bool IsModifica => corrente.Id > 0;

    #endregion

    #region Lifecycle

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !_wasVisible)
        {
            _wasVisible = true;
            corrente = new ClienteAmbienteDto();
            messaggio = string.Empty;
            collegamentoEditorNeedsUpdate = true;
            datiAmbienteEditorNeedsUpdate = true;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registraCtrlSModal", _dotNetRef);

            if (listaCaricata)
            {
                // Riapertura: la griglia è già popolata, si aggiorna senza bloccare
                _ = CaricaTutto(inBackground: true);
            }
            else
            {
                await CaricaTutto();
            }
        }
        else if (!IsVisible && _wasVisible)
        {
            _wasVisible = false;
            await JS.InvokeVoidAsync("deregistraCtrlSModal");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (collegamentoEditorNeedsUpdate && IsVisible)
        {
            collegamentoEditorNeedsUpdate = false;
            try
            {
                await JS.InvokeVoidAsync("collegamentoEditorHelper.setContent",
                    collegamentoEditorRef, corrente.ComeCollegarsi ?? string.Empty);
            }
            catch { /* ref non ancora pronto */ }
        }

        if (datiAmbienteEditorNeedsUpdate && IsVisible)
        {
            datiAmbienteEditorNeedsUpdate = false;
            try
            {
                await JS.InvokeVoidAsync("datiAmbienteEditorHelper.setContent",
                    datiAmbienteEditorRef, corrente.DatiAmbiente ?? string.Empty);
            }
            catch { /* ref non ancora pronto */ }
        }
    }

    #endregion

    #region Data Loading

    /// <summary>
    /// Carica la griglia e le liste di supporto del form.
    /// Le quattro query partono INSIEME (ogni servizio apre il proprio DbContext dalla factory):
    /// via VPN ogni query in sequenza costava un giro di rete in più. La griglia viene mostrata
    /// appena arriva, senza aspettare clienti / ambienti distinti / congelati, che servono solo
    /// alle combo del form.
    /// Con <paramref name="inBackground"/> (riapertura della finestra) la griglia resta visibile
    /// con i dati precedenti e compare solo l'indicatore "aggiornamento…".
    /// </summary>
    private async Task CaricaTutto(bool inBackground = false)
    {
        var generazione = ++_generazioneCaricamento;
        if (inBackground) isAggiornamento = true; else isLoading = true;

        var taskRighe = ClienteAmbienteService.GetAllAsync();
        var taskClienti = ClienteService.GetClientiAsync();
        var taskAmbientiDistinti = ClienteAmbienteService.GetAmbientiDistintiAsync();
        var taskCongelati = AmbienteService.GetAmbientiAsync();

        try
        {
            try
            {
                var nuoveRighe = await taskRighe;
                if (generazione != _generazioneCaricamento) return;
                righe = nuoveRighe;
                listaCaricata = true;
            }
            finally
            {
                // La griglia è pronta (o è fallita): la rotellina principale si spegne subito
                if (generazione == _generazioneCaricamento)
                {
                    isLoading = false;
                    AggiornaVista();
                }
            }

            await Task.WhenAll(taskClienti, taskAmbientiDistinti, taskCongelati);
            if (generazione != _generazioneCaricamento) return;
            clienti = taskClienti.Result;
            ambientiDistinti = taskAmbientiDistinti.Result;
            congelatiAttivi = taskCongelati.Result;
        }
        catch (Exception ex)
        {
            if (generazione != _generazioneCaricamento) return;
            MostraMessaggio(inBackground
                ? $"Aggiornamento dell'elenco non riuscito, sono mostrati i dati dell'apertura precedente: {ex.Message}"
                : $"Errore nel caricamento: {ex.Message}", true);
        }
        finally
        {
            // Se la griglia è fallita, WhenAll non è stato atteso: osserva comunque le altre
            // query per non lasciare eccezioni non osservate.
            _ = Task.WhenAll(taskClienti, taskAmbientiDistinti, taskCongelati)
                .ContinueWith(t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);

            if (generazione == _generazioneCaricamento)
            {
                isLoading = false;
                isAggiornamento = false;
                AggiornaVista();
            }
        }
    }

    /// <summary>
    /// Ridisegna la modale. Serve perché il caricamento in background non nasce da un evento
    /// UI, quindi Blazor non ridisegnerebbe da solo; protetto contro la chiusura dell'app.
    /// </summary>
    private void AggiornaVista()
    {
        if (_disposed) return;
        try { StateHasChanged(); }
        catch (ObjectDisposedException) { /* renderer già chiuso */ }
    }

    #endregion

    #region CRUD

    private void Nuovo()
    {
        corrente = new ClienteAmbienteDto();
        messaggio = string.Empty;
        collegamentoEditorNeedsUpdate = true;
        datiAmbienteEditorNeedsUpdate = true;
    }

    /// <summary>
    /// Porta nel form la riga selezionata. La griglia è caricata in forma leggera (senza
    /// "Come collegarsi" e "Dati ambiente", che contengono gli screenshot), quindi i due campi
    /// ricchi vengono letti ORA con una query mirata sul singolo record.
    /// </summary>
    private async Task Seleziona(ClienteAmbienteDto r)
    {
        messaggio = string.Empty;

        corrente = new ClienteAmbienteDto
        {
            Id = r.Id,
            ClienteId = r.ClienteId,
            NomeCliente = r.NomeCliente,
            Ambiente = r.Ambiente,
            TipoVersione = r.TipoVersione,
            NumeroVersione = r.NumeroVersione,
            ApplicationServer = r.ApplicationServer,
            DatabaseServer = r.DatabaseServer,
            PersoneRiferimento = r.PersoneRiferimento,
            DirectoryInstallazione = r.DirectoryInstallazione,
            InformazioniPool = r.InformazioniPool,
            DataModifica = r.DataModifica,
            UltimoUtente = r.UltimoUtente
        };

        await CaricaCampiRicchiAsync(r.Id);

        collegamentoEditorNeedsUpdate = true;
        datiAmbienteEditorNeedsUpdate = true;
    }

    /// <summary>
    /// Legge dal database "Come collegarsi" e "Dati ambiente" del record indicato e li riversa
    /// in <c>corrente</c>. Mostra la rotellina della griglia perché su una riga con molti
    /// screenshot, via VPN, il trasferimento può richiedere qualche secondo.
    /// </summary>
    private async Task CaricaCampiRicchiAsync(int id)
    {
        if (id <= 0) return;

        isLoading = true;
        StateHasChanged();
        try
        {
            var completo = await ClienteAmbienteService.GetByIdAsync(id);
            corrente.ComeCollegarsi = completo?.ComeCollegarsi;
            corrente.DatiAmbiente = completo?.DatiAmbiente;
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore nel caricamento del dettaglio: {ex.Message}", true);
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Clona la riga nel form come nuovo record. I campi ricchi vengono letti dal database
    /// (vedi <see cref="Seleziona"/>) prima di azzerare l'Id.
    /// </summary>
    private async Task Clona(ClienteAmbienteDto r)
    {
        corrente = new ClienteAmbienteDto
        {
            Id = 0,
            ClienteId = r.ClienteId,
            NomeCliente = r.NomeCliente,
            Ambiente = r.Ambiente,
            TipoVersione = r.TipoVersione,
            NumeroVersione = r.NumeroVersione,
            ApplicationServer = r.ApplicationServer,
            DatabaseServer = r.DatabaseServer,
            PersoneRiferimento = r.PersoneRiferimento,
            DirectoryInstallazione = r.DirectoryInstallazione,
            InformazioniPool = r.InformazioniPool,
            DataModifica = null
        };

        // Il record sorgente è r.Id; corrente.Id resta 0 perché è un nuovo inserimento.
        await CaricaCampiRicchiAsync(r.Id);

        MostraMessaggio("Record clonato nel form. Modifica l'ambiente e premi Salva per creare il nuovo record.", false);
        collegamentoEditorNeedsUpdate = true;
        datiAmbienteEditorNeedsUpdate = true;
    }

    private async Task Salva()
    {
        try
        {
            isSaving = true;

            // Legge l'HTML dagli editor
            try
            {
                corrente.ComeCollegarsi = await JS.InvokeAsync<string>(
                    "collegamentoEditorHelper.getHtml", collegamentoEditorRef);
            }
            catch { /* editor non accessibile — mantiene valore esistente */ }

            try
            {
                corrente.DatiAmbiente = await JS.InvokeAsync<string>(
                    "datiAmbienteEditorHelper.getHtml", datiAmbienteEditorRef);
            }
            catch { /* editor non accessibile — mantiene valore esistente */ }

            if (IsModifica)
            {
                corrente = await ClienteAmbienteService.UpdateAsync(corrente);
                MostraMessaggio("Ambiente cliente aggiornato.", false);
            }
            else
            {
                corrente = await ClienteAmbienteService.AddAsync(corrente);
                MostraMessaggio("Ambiente cliente aggiunto.", false);
            }

            ultimoSalvataggioModal = DateTime.Now;
            lampeggiaSalvataggio = true;
            _ = Task.Run(async () =>
            {
                await Task.Delay(4000);
                lampeggiaSalvataggio = false;
                await InvokeAsync(StateHasChanged);
            });

            await CaricaTutto();
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore nel salvataggio: {ex.Message}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ChiediElimina(ClienteAmbienteDto r)
    {
        daEliminare = r;
        mostraConfermaElimina = true;
    }

    private void AnnullaElimina()
    {
        mostraConfermaElimina = false;
        daEliminare = null;
    }

    private async Task ConfermaElimina()
    {
        if (daEliminare == null)
        {
            mostraConfermaElimina = false;
            return;
        }
        try
        {
            await ClienteAmbienteService.DeleteAsync(daEliminare.Id);
            if (corrente.Id == daEliminare.Id)
            {
                Nuovo();
            }
            await CaricaTutto();
            MostraMessaggio("Ambiente cliente eliminato.", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore nell'eliminazione: {ex.Message}", true);
        }
        finally
        {
            mostraConfermaElimina = false;
            daEliminare = null;
        }
    }

