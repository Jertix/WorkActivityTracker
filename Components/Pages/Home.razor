    /// <summary>
    /// Compila le 3 coppie "Ambiente di rilascio / Versione" copiandole dall'ULTIMO ticket
    /// lavorato per lo stesso cliente. La ricerca spazia su tutti gli utenti (come in modalità
    /// admin), esclusi quelli in PrivacyMode, e ignora l'attività attualmente aperta.
    /// I valori già presenti nel form vengono sovrascritti: è un'azione esplicita dell'utente.
    /// </summary>
    private async Task AutocompilaAmbientiRilascio()
    {
        if (!(AttivitaCorrente.ClienteId > 0))
        {
            MostraMessaggio("Seleziona prima un cliente.", true);
            return;
        }

        try
        {
            isCaricamentoAmbientiRilascio = true;

            var ultimo = await AmbientiRilascioService.GetUltimiAmbientiPerClienteAsync(
                AttivitaCorrente.ClienteId!.Value, AttivitaCorrente.Id);

            if (ultimo == null)
            {
                MostraMessaggio(
                    $"Nessun ticket precedente con ambienti di rilascio per il cliente \"{NomeClientePatch()}\".", true);
                return;
            }

            // Riscrive tutte e 3 le posizioni: quelle non presenti nell'origine restano vuote.
            for (int i = 0; i < AttivitaCorrente.AmbientiRilascio.Count; i++)
            {
                var origine = ultimo.Coppie.FirstOrDefault(c => c.Posizione == i + 1);
                AttivitaCorrente.AmbientiRilascio[i].TipoAmbiente = origine?.TipoAmbiente;
                AttivitaCorrente.AmbientiRilascio[i].Versione = origine?.Versione;
            }

            var compilate = ultimo.Coppie.Count(c =>
                !string.IsNullOrWhiteSpace(c.TipoAmbiente) || !string.IsNullOrWhiteSpace(c.Versione));
            var ticket = string.IsNullOrWhiteSpace(ultimo.NumeroTicket) ? "senza numero" : ultimo.NumeroTicket;
            var utente = string.IsNullOrWhiteSpace(ultimo.UtenteUsername) ? "" : $" — {ultimo.UtenteUsername}";

            MostraMessaggio(
                $"Compilate {compilate} coppie dal ticket {ticket} del {ultimo.Data:dd/MM/yyyy}{utente}.", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore autocompilazione ambienti di rilascio: {ex.Message}", true);
        }
        finally
        {
            isCaricamentoAmbientiRilascio = false;
        }
    }

    /// <summary>
    /// Compila "Testo del check-in" come "Numero del ticket - Descrizione".
    /// Se uno dei due campi è vuoto, usa solo quello valorizzato (senza il trattino).
    /// </summary>
    private void AutocompilaTestoCheckIn()
    {
        var ticket = (AttivitaCorrente.NumeroTicket ?? "").Trim();
        var desc = (AttivitaCorrente.Descrizione ?? "").Trim();
        AttivitaCorrente.TestoCheckIn = (ticket.Length > 0 && desc.Length > 0)
            ? $"{ticket} - {desc}"
            : (ticket.Length > 0 ? ticket : desc);
    }

