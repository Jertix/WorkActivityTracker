@* ===== MODALE INSERIMENTO README ===== *@
<ReadmeTemplatesModal
    IsVisible="@mostraReadmeModal"
    Templates="@readmeTemplatesFiltrati"
    OnChiudi="@ChiudiReadmeModal"
    OnInserisci="@OnInserisciReadme" />

@* ===== MODALE SEGNALAZIONI ===== *@
<SegnalazioniModal
    IsVisible="@mostraSegnalazioni"
    OnChiudi="@ChiudiSegnalazioni" />

@* ===== MODALE EDITOR TIPI ATTIVITÀ ===== *@
<TipiAttivitaEditorModal
    IsVisible="@mostraEditorTipiAttivita"
    OnChiudi="@ChiudiEditorTipiAttivita"
    OnTipiChanged="@OnTipiAttivitaChanged" />

@* ===== MODALE CALENDARIO ===== *@
<CalendarioModal
    IsVisible="@mostraCalendario"
    OnChiudi="@ChiudiCalendario"
    OnEventiChanged="@OnEventiCalendarioChanged" />

@* ===== MODALE STORICO VERSIONI NOTE ===== *@
<EditorHistoryModal
    Visibile="@_mostraStoriciNote"
    VisibileChanged="@(v => _mostraStoriciNote = v)"
    Storico="@(_noteHistory ?? new())"
    SuSeleziona="@RipristinaVersioneNote"
    Titolo="Note" />

@* ===== MODALE STORICO VERSIONI CHANGESET ===== *@
<EditorHistoryModal
    Visibile="@_mostraStoriciChangeset"
    VisibileChanged="@(v => _mostraStoriciChangeset = v)"
    Storico="@(_changesetHistory ?? new())"
    SuSeleziona="@RipristinaVersioneChangeset"
    Titolo="Changeset" />

@* ===== MODALE CONFERMA ELIMINAZIONE ===== *@
@if (mostraConfermaElimina && attivitaDaEliminare != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">🗑️ Conferma Eliminazione</h5>
                </div>
                <div class="modal-body">
                    <p>Sei sicuro di voler eliminare questa attività?</p>
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td class="fw-bold text-muted" style="width: 80px;">Data:</td>
                            <td>@attivitaDaEliminare.Data.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-muted">Titolo:</td>
                            <td>@TruncateText(attivitaDaEliminare.Descrizione, 80)</td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="AnnullaElimina">❌ Annulla</button>
                    <button class="btn btn-danger" @onclick="ConfermaElimina">🗑️ Sì, elimina</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== POPUP ERRORE DATABASE ===== *@
@if (mostraPopupErroreDb)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 3000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">⚠️ Errore Database</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-1 fw-bold text-danger">Si è verificato un errore durante l'operazione:</p>
                    <p class="mb-0" style="white-space: pre-wrap; word-break: break-word;">@messaggioPopupErroreDb</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="() => mostraPopupErroreDb = false">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== BARRA DI STATO IN BASSO ===== *@
<div class="status-bar @(statusBarLampeggia ? "status-bar-pulse" : "")">
    @if (ultimoSalvataggio.HasValue)
    {
        <span>💾 Ultimo salvataggio: @ultimoSalvataggio.Value.ToString("HH:mm:ss")</span>
    }
    else
    {
        <span class="text-secondary">💾 Nessun salvataggio in questa sessione</span>
    }
    @if (!string.IsNullOrEmpty(ultimoExport))
    {
        <span title="@ultimoExport">📤 Export: @System.IO.Path.GetFileName(ultimoExport)</span>
    }
    @if (isAdminMode)
    {
        <span class="badge bg-warning text-dark">🔐 Modalità Admin attiva</span>
    }
    @if (AppConfig.PrivacyMode)
    {
        <span class="badge bg-info text-dark">🔒 Privacy attiva</span>
    }
    <span class="ms-auto text-secondary">v@(AppConfig.Version)</span>
</div>

@code {
    #region Proprietà e Campi

