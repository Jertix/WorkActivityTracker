        var oggi = DateTime.Today;
        FiltroAnno = System.Globalization.ISOWeek.GetYear(oggi);
        FiltroMese = null;
        FiltroGiorno = null;
        FiltroSettimana = System.Globalization.ISOWeek.GetWeekOfYear(oggi);
