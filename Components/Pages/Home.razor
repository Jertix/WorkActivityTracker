    /// <summary>
    /// Verifica se un'attività contiene la parola TODO come parola isolata
    /// (non come parte di un'altra parola, es: "metodo" non conta).
    /// Usa regex con word boundary per maggiore precisione.
    /// </summary>
    private bool ContieneTodo(WorkActivityDto attivita)
    {
        return TodoRegex.IsMatch(attivita.Descrizione ?? "")
            || TodoRegex.IsMatch(HtmlToPlainText(attivita.Note))
            || TodoRegex.IsMatch(HtmlToPlainText(attivita.ChangesetCoinvolti))
            || TodoRegex.IsMatch(attivita.UrlTicket ?? "");
    }

    /// <summary>
    /// Verifica se uno specifico campo di testo contiene TODO come parola isolata.
    /// Usato per evidenziare con bordo rosso il campo corrispondente nel form
    /// quando l'attività selezionata contiene TODO.
    /// </summary>
    private bool CampoHaTodo(string? campo) =>
        IsModifica && !string.IsNullOrEmpty(campo) && TodoRegex.IsMatch(HtmlToPlainText(campo));

    // ===== Regex per rilevare URL nel campo UrlTicket =====
    private static readonly System.Text.RegularExpressions.Regex UrlRegex =
        new(@"https?://[^\s]+", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    /// <summary>
    /// Record che rappresenta un segmento di testo (URL o testo plain) per la visualizzazione cliccabile.
    /// </summary>
    private record UrlSegmento(string Testo, bool IsUrl);

    /// <summary>
    /// Verifica se il testo contiene almeno un URL http/https.
    /// </summary>
    private static bool ContienUrl(string? testo) =>
        !string.IsNullOrEmpty(testo) && UrlRegex.IsMatch(testo);

    // ===== Regex per estrarre il numero del ticket dagli URL =====
    private static readonly System.Text.RegularExpressions.Regex TicketServiceDeskRegex =
        new(@"/Detail/([^/$?#\s]+)\$entity", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    private static readonly System.Text.RegularExpressions.Regex TicketTfsPathRegex =
        new(@"/_workitems/edit/([A-Za-z0-9]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    private static readonly System.Text.RegularExpressions.Regex TicketTfsQueryRegex =
        new(@"[?&]id=([A-Za-z0-9]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    /// <summary>
    /// Estrae il numero/codice ticket da un singolo URL, o null se il formato non è riconosciuto.
    /// </summary>
    private static string? EstraiNumeroDaUrl(string url)
    {
        var m = TicketServiceDeskRegex.Match(url);
        if (m.Success) return m.Groups[1].Value;
        m = TicketTfsPathRegex.Match(url);
        if (m.Success) return m.Groups[1].Value;
        m = TicketTfsQueryRegex.Match(url);
        if (m.Success) return m.Groups[1].Value;
        return null; // formato non noto → ignorato
    }

    /// <summary>
    /// Estrae i numeri dei ticket dagli URL presenti in "URL Ticket" (nell'ordine di comparsa)
    /// e aggiunge in coda a "Numero del ticket" solo quelli non ancora presenti, preservando
    /// ordine e valori inseriti manualmente. Separatore: ", ".
    /// </summary>
    private void AutoCompilaNumeroTicket()
    {
        if (string.IsNullOrWhiteSpace(AttivitaCorrente.UrlTicket)) return;

        // Numeri già presenti nel campo (split su virgola), per confronto case-insensitive.
        var esistenti = (AttivitaCorrente.NumeroTicket ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        var presenti = new HashSet<string>(esistenti, StringComparer.OrdinalIgnoreCase);

        var risultato = new List<string>(esistenti);
        var aggiunti = false;
        foreach (System.Text.RegularExpressions.Match m in UrlRegex.Matches(AttivitaCorrente.UrlTicket))
        {
            var n = EstraiNumeroDaUrl(m.Value);
            if (n != null && presenti.Add(n)) // Add ritorna false se già presente → niente duplicati
            {
                risultato.Add(n);
                aggiunti = true;
            }
        }

        if (aggiunti)
            AttivitaCorrente.NumeroTicket = string.Join(", ", risultato);
    }

    /// <summary>
    /// Divide il testo in segmenti URL e non-URL per la visualizzazione cliccabile.
    /// </summary>
    private static List<UrlSegmento> ParseUrlSegmenti(string? testo)
    {
        var result = new List<UrlSegmento>();
        if (string.IsNullOrEmpty(testo)) return result;

        var lastIndex = 0;
        foreach (System.Text.RegularExpressions.Match m in UrlRegex.Matches(testo))
        {
            if (m.Index > lastIndex)
                result.Add(new UrlSegmento(testo[lastIndex..m.Index], false));
            result.Add(new UrlSegmento(m.Value, true));
            lastIndex = m.Index + m.Length;
        }
        if (lastIndex < testo.Length)
            result.Add(new UrlSegmento(testo[lastIndex..], false));

        return result;
    }

