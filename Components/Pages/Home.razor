                    FileName = "explorer.exe",
                    Arguments = AttivitaCorrente.CartellaDocumentazione,
                    UseShellExecute = true
                });
            }
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore nell'apertura della cartella: {ex.Message}", true);
        }
    }

