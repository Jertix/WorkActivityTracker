@using WorkActivityTracker.Models
@using WorkActivityTracker.Services
@inject ClienteService ClienteService
@inject ClienteAmbienteService ClienteAmbienteService
@inject AmbienteService AmbienteService
@inject PdfExportService PdfExportService
@inject IJSRuntime JS
@implements IDisposable

@*
    Componente modale per la gestione degli ambienti per cliente (v4.7).
    Dati CONDIVISI tra tutti gli utenti. Include logging di tutte le modifiche.
    Campo "Come collegarsi" con editor rich HTML (toolbar completa come Note).
*@

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-scrollable modal-xl" style="max-width: 90%;">
            <div class="modal-content" style="height: 90vh;">

                @* ===== HEADER ===== *@
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        🏢 Gestione Clienti
                        <span class="save-indicator @(lampeggiaSalvataggio ? "save-indicator-on" : "")"
                              title="Indicatore salvataggio (lampeggia quando un record viene salvato)"></span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="Chiudi"></button>
                </div>

                @* ===== BODY ===== *@
                <div class="modal-body" style="overflow-y: auto;">

                    @* Banner info condivisione *@
                    <div class="alert alert-info py-2 mb-3 small">
                        ⚠️ <strong>Attenzione:</strong> le informazioni mostrate in questa finestra sono uguali e condivise per tutti gli utenti che utilizzano questo programma.
                        Non inserire <strong>dati sensibili</strong> nei campi sottostanti: per i dati sensibili utilizzare esclusivamente <strong>1Password</strong>.
                    </div>

                    @* ===== GRIGLIA AMBIENTI CLIENTE ===== *@
                    <div class="card mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong>Elenco Ambienti Cliente (@righe.Count elementi)</strong>
                            <div class="d-flex align-items-center gap-2">
                                @if (isLoading)
                                {
                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">Caricamento...</span>
                                    </div>
                                }
                                else if (isAggiornamento)
                                {
                                    <span class="small text-muted d-flex align-items-center gap-1"
                                          title="L'elenco mostrato è quello dell'apertura precedente: è in corso il ricaricamento dal database">
                                        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                                        aggiornamento…
                                    </span>
                                }
                                <button class="btn btn-success btn-sm" @onclick="Nuovo" disabled="@isSaving">
                                    ➕ Nuovo
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div style="max-height: 250px; overflow-y: auto;">
                                <table class="table table-hover table-striped mb-0">
                                    <thead class="table-dark sticky-top">
                                        <tr>
                                            <th>Cliente</th>
                                            <th>Ambiente</th>
                                            <th style="width: 160px;">Versione</th>
                                            <th style="width: 140px;">Data ultimo aggiornamento</th>
                                            <th style="width: 120px;">Utente</th>
                                            <th style="width: 160px;">Azioni</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (righe.Any())
                                        {
                                            @foreach (var r in righe)
                                            {
                                                <tr @onclick="() => Seleziona(r)"
                                                    class="@(corrente.Id == r.Id ? "table-active" : "")"
                                                    style="cursor: pointer;">
                                                    <td class="fw-bold">@r.NomeCliente</td>
                                                    <td>@r.Ambiente</td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(r.TipoVersione))
                                                        {
                                                            <span class="badge bg-secondary me-1">@TipoVersionePrefix(r.TipoVersione)</span>
                                                        }
                                                        @r.NumeroVersione
                                                    </td>
                                                    <td class="small text-muted">
                                                        @(r.DataModifica.HasValue ? r.DataModifica.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                                    </td>
                                                    <td class="small text-muted">
                                                        @(r.UltimoUtente ?? "-")
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-danger me-1"
                                                                @onclick="() => EsportaClientePdf(r)"
                                                                @onclick:stopPropagation="true"
                                                                disabled="@IsExporting"
                                                                title="Esporta in PDF tutte le info di questo cliente (tutti i suoi ambienti)">
                                                            @if (exportClienteId == r.ClienteId && exportInCorso == "PDF")
                                                            {
                                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-filetype-pdf"></i>
                                                            }
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-info me-1"
                                                                @onclick="() => Clona(r)"
                                                                @onclick:stopPropagation="true"
                                                                title="Clona questo record nel form">
                                                            <i class="bi bi-copy"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => ChiediElimina(r)"
                                                                @onclick:stopPropagation="true"
                                                                title="Elimina">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else if (!listaCaricata && isLoading)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">
                                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                    Caricamento elenco in corso, attendere…
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">
                                                    Nessun ambiente cliente presente. Premi "Nuovo" per aggiungerne uno.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @* ===== BARRA EXPORT ===== *@
                    <div class="d-flex gap-1 flex-wrap align-items-center justify-content-end mb-3">
                        @* Rotellina prima dei pulsanti: comparendo cresce verso sinistra e non
                           sposta i due pulsanti, che restano ancorati al bordo destro. *@
                        @if (IsExporting)
                        {
                            <span class="text-primary d-inline-flex align-items-center me-2" role="status">
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                Generazione @exportInCorso in corso…
                            </span>
                        }
                        <button class="btn btn-outline-success btn-sm" @onclick="EsportaElencoXlsx"
                                disabled="@IsExporting"
                                title="Esporta l'elenco degli ambienti cliente in formato Excel (.xlsx)">
                            <i class="bi bi-filetype-xlsx me-1"></i>Esporta elenco XLSX
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ApriCartellaExport"
                                title="Apri la cartella Export del programma">
                            <i class="bi bi-folder2-open me-1"></i>Apri Export
                        </button>
                    </div>

                    @* ===== FORM DETTAGLIO ===== *@
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong>@(IsModifica ? "📝 Modifica Ambiente Cliente" : "➕ Nuovo Ambiente Cliente")</strong>
                            @if (corrente.Id > 0)
                            {
                                <span class="badge bg-primary">ID: @corrente.Id</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @* Cliente *@
                                <div class="col-md-6">
                                    <label class="form-label">Cliente <span class="text-danger">*</span></label>
                                    <select class="form-select" @bind="corrente.ClienteId">
                                        <option value="0">-- Seleziona cliente --</option>
                                        @foreach (var c in clienti)
                                        {
                                            <option value="@c.Id">@c.Nome</option>
                                        }
                                    </select>
                                </div>

                                @* Ambiente *@
                                <div class="col-md-6">
                                    <label class="form-label">Ambiente <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" list="datalistAmbienti"
                                           @bind="corrente.Ambiente"
                                           maxlength="100"
                                           placeholder="Es: Test, Qualità, Produzione..." />
                                    <datalist id="datalistAmbienti">
                                        @foreach (var a in ambientiDistinti)
                                        {
                                            <option value="@a"></option>
                                        }
                                    </datalist>
                                </div>

                                @* Tipo di Versione *@
                                <div class="col-md-3">
                                    <label class="form-label">Tipo di Versione</label>
                                    <select class="form-select" @bind="corrente.TipoVersione">
                                        <option value="">-- Nessuno --</option>
                                        <option value="Versione">Versione</option>
                                        <option value="Versione4">Versione4</option>
                                        <option value="Versione5">Versione5</option>
                                    </select>
                                </div>

                                @* Numero della versione *@
                                <div class="col-md-3">
                                    <label class="form-label">Numero della versione</label>
                                    <input type="text" class="form-control" list="datalistNumeriVersione"
                                           @bind="corrente.NumeroVersione"
                                           maxlength="100"
                                           placeholder="Es: 3.2.50" />
                                    <datalist id="datalistNumeriVersione">
                                        @foreach (var n in NumeriVersioneSuggeriti)
                                        {
                                            <option value="@n"></option>
                                        }
                                    </datalist>
                                </div>

                                @* Application Server *@
                                <div class="col-md-6">
                                    <label class="form-label">Application Server</label>
                                    <input type="text" class="form-control" @bind="corrente.ApplicationServer"
                                           maxlength="500" placeholder="Es: APP01.azienda.local" />
                                </div>

                                @* Database Server *@
                                <div class="col-md-6">
                                    <label class="form-label">Database Server</label>
                                    <input type="text" class="form-control" @bind="corrente.DatabaseServer"
                                           maxlength="500" placeholder="Es: DB01.azienda.local\SQL2019" />
                                </div>

                                @* Persone di riferimento *@
                                <div class="col-12">
                                    <label class="form-label">Persone di riferimento</label>
                                    <textarea class="form-control" rows="3"
                                              @bind="corrente.PersoneRiferimento"
                                              placeholder="Nomi, email, telefoni dei referenti..."></textarea>
                                </div>

                                @* Directory installazione + Info pool *@
                                <div class="col-md-8">
                                    <label class="form-label">Directory di installazione di XLayers</label>
                                    <input type="text" class="form-control" @bind="corrente.DirectoryInstallazione"
                                           placeholder="Es: c:\inetpub\wwwroot\XLayers" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Informazioni sul pool</label>
                                    <input type="text" class="form-control" @bind="corrente.InformazioniPool"
                                           maxlength="1000"
                                           placeholder="Es: 32bit / 64bit, identity, ecc." />
                                </div>

                                @* Come collegarsi (rich HTML editor) *@
                                <div class="col-12">
                                    <label class="form-label">Come collegarsi</label>
                                    @* Toolbar sopra *@
                                    <div class="editor-toolbar">
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoIndentaLeft"
                                                title="Indenta a sinistra" @onmousedown:preventDefault>
                                            ⇤ ←
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoIndentaRight"
                                                title="Indenta a destra" @onmousedown:preventDefault>
                                            ⇥ →
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-dark btn-sm fw-bold" type="button"
                                                @onclick="CollegamentoBold"
                                                title="Grassetto">
                                            G
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoHighlightGiallo"
                                                title="Evidenzia in giallo"
                                                style="background-color: yellow; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoHighlightArancione"
                                                title="Evidenzia in arancione"
                                                style="background-color: orange; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoHighlightVerde"
                                                title="Evidenzia in verde"
                                                style="background-color: lightgreen; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoBarrato"
                                                title="Barrato"
                                                style="text-decoration: line-through;">
                                            S
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoSottolineato"
                                                title="Sottolineato"
                                                style="text-decoration: underline;">
                                            S
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoColoreRosso"
                                                title="Colora in rosso"
                                                style="color: red; font-weight: bold; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoRimuoviFormattazione"
                                                title="Rimuovi formattazione">
                                            ✕
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoInserisciTimestamp"
                                                title="Inserisci data e ora correnti (dd-MM-yyyy HH:mm:ss)">
                                            🕐
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoInserisciSeparatore"
                                                title="Separatore sottile">
                                            ─
                                        </button>
                                        <button class="btn btn-outline-dark btn-sm" type="button"
                                                @onclick="CollegamentoInserisciSeparatoreSpesso"
                                                title="Separatore spesso"
                                                style="font-weight: 900;">
                                            █
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoInserisciSeparatoreRosso"
                                                title="Separatore rosso"
                                                style="color: red; font-weight: 900; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            █
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoRimuoviRigheVuote"
                                                title="Rimuovi righe vuote"
                                                @onmousedown:preventDefault>
                                            ⊟
                                        </button>
                                    </div>
                                    <div @ref="collegamentoEditorRef"
                                         id="collegamento-editor-div"
                                         onkeydown="collegamentoEditorHelper.handleTab(event,this)"
                                         contenteditable="true"
                                         class="form-control note-editor"
                                         style="min-height: 320px; max-height: 600px; overflow-y: auto; overflow-x: auto; white-space: pre;"
                                         placeholder="Procedura, link, credenziali, VPN, RDP, ecc.">
                                    </div>
                                    @* Toolbar duplicata sotto l'editor *@
                                    <div class="editor-toolbar">
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoIndentaLeft"
                                                title="Indenta a sinistra" @onmousedown:preventDefault>
                                            ⇤ ←
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoIndentaRight"
                                                title="Indenta a destra" @onmousedown:preventDefault>
                                            ⇥ →
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-dark btn-sm fw-bold" type="button"
                                                @onclick="CollegamentoBold"
                                                title="Grassetto">
                                            G
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoHighlightGiallo"
                                                title="Evidenzia in giallo"
                                                style="background-color: yellow; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoHighlightArancione"
                                                title="Evidenzia in arancione"
                                                style="background-color: orange; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoHighlightVerde"
                                                title="Evidenzia in verde"
                                                style="background-color: lightgreen; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoBarrato"
                                                title="Barrato"
                                                style="text-decoration: line-through;">
                                            S
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoSottolineato"
                                                title="Sottolineato"
                                                style="text-decoration: underline;">
                                            S
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoColoreRosso"
                                                title="Colora in rosso"
                                                style="color: red; font-weight: bold; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoRimuoviFormattazione"
                                                title="Rimuovi formattazione">
                                            ✕
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoInserisciTimestamp"
                                                title="Inserisci data e ora correnti (dd-MM-yyyy HH:mm:ss)">
                                            🕐
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoInserisciSeparatore"
                                                title="Separatore sottile">
                                            ─
                                        </button>
                                        <button class="btn btn-outline-dark btn-sm" type="button"
                                                @onclick="CollegamentoInserisciSeparatoreSpesso"
                                                title="Separatore spesso"
                                                style="font-weight: 900;">
                                            █
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="CollegamentoInserisciSeparatoreRosso"
                                                title="Separatore rosso"
                                                style="color: red; font-weight: 900; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            █
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="CollegamentoRimuoviRigheVuote"
                                                title="Rimuovi righe vuote"
                                                @onmousedown:preventDefault>
                                            ⊟
                                        </button>
                                    </div>
                                </div>

                                @* Dati recuperati dall'ambiente del cliente (rich HTML editor) *@
                                <div class="col-12">
                                    <label class="form-label">Dati recuperati dall'ambiente del cliente <span class="text-muted small">(Installationlog.ini, proprietà di sistema, ecc.)</span></label>
                                    @* Toolbar sopra *@
                                    <div class="editor-toolbar">
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteIndentaLeft"
                                                title="Indenta a sinistra" @onmousedown:preventDefault>
                                            ⇤ ←
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteIndentaRight"
                                                title="Indenta a destra" @onmousedown:preventDefault>
                                            ⇥ →
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-dark btn-sm fw-bold" type="button"
                                                @onclick="DatiAmbienteBold"
                                                title="Grassetto">
                                            G
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="DatiAmbienteHighlightGiallo"
                                                title="Evidenzia in giallo"
                                                style="background-color: yellow; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="DatiAmbienteHighlightArancione"
                                                title="Evidenzia in arancione"
                                                style="background-color: orange; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="DatiAmbienteHighlightVerde"
                                                title="Evidenzia in verde"
                                                style="background-color: lightgreen; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteBarrato"
                                                title="Barrato"
                                                style="text-decoration: line-through;">
                                            S
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteSottolineato"
                                                title="Sottolineato"
                                                style="text-decoration: underline;">
                                            S
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="DatiAmbienteColoreRosso"
                                                title="Colora in rosso"
                                                style="color: red; font-weight: bold; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            A
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteRimuoviFormattazione"
                                                title="Rimuovi formattazione">
                                            ✕
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteInserisciTimestamp"
                                                title="Inserisci data e ora correnti (dd-MM-yyyy HH:mm:ss)">
                                            🕐
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteInserisciSeparatore"
                                                title="Separatore sottile">
                                            ─
                                        </button>
                                        <button class="btn btn-outline-dark btn-sm" type="button"
                                                @onclick="DatiAmbienteInserisciSeparatoreSpesso"
                                                title="Separatore spesso"
                                                style="font-weight: 900;">
                                            █
                                        </button>
                                        <button class="btn btn-sm" type="button"
                                                @onclick="DatiAmbienteInserisciSeparatoreRosso"
                                                title="Separatore rosso"
                                                style="color: red; font-weight: 900; border: 1px solid #ccc; font-size: 0.75rem; padding: 2px 7px;">
                                            █
                                        </button>
                                        <div class="separator"></div>
                                        <button class="btn btn-outline-secondary btn-sm" type="button"
                                                @onclick="DatiAmbienteRimuoviRigheVuote"
                                                title="Rimuovi righe vuote"
                                                @onmousedown:preventDefault>
                                            ⊟
                                        </button>
                                    </div>
                                    <div @ref="datiAmbienteEditorRef"
                                         id="dati-ambiente-editor-div"
                                         onkeydown="datiAmbienteEditorHelper.handleTab(event,this)"
                                         contenteditable="true"
                                         class="form-control note-editor"
