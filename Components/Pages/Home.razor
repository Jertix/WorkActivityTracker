    private Task EsportaDettagliPdf() => EseguiExportAsync("PDF", async () =>
    {
        try
        {
            var dal = Attivita.Any() ? Attivita.Min(a => a.Data).ToString("yyyyMMdd") : "n_a";
            var al  = Attivita.Any() ? Attivita.Max(a => a.Data).ToString("yyyyMMdd") : "n_a";
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var nomeFile = $"DettaglioTutteLeAttività_{dal}_{al}_{timestamp}.pdf";
            var percorso = System.IO.Path.Combine(GetExportFolder(), nomeFile);

            // La griglia è in modalità leggera (senza Note/Changeset): ricarica le stesse attività
            // in modalità completa (con i contenuti) usando i filtri correnti, così l'export è completo.
            var attivitaComplete = await ActivityService.GetActivitiesAsync(
                FiltroAnno, FiltroMese, FiltroGiorno,
                string.IsNullOrWhiteSpace(TestoRicerca) ? null : TestoRicerca,
                isAdminMode, FiltroSettimana, includeContenuto: true);
            if (filtroSoloTodo)
                attivitaComplete = attivitaComplete.Where(a => a.HasTodo).ToList();

            // Ambienti di rilascio in un'unica query per tutte le attività esportate.
            var ambientiPerAttivita = await AmbientiRilascioService.GetAmbientiRilascioBatchAsync(
                attivitaComplete.Select(a => a.Id));
            foreach (var a in attivitaComplete)
            {
                a.AmbientiRilascio = ambientiPerAttivita.TryGetValue(a.Id, out var coppie)
                    ? coppie
                    : new List<AmbienteRilascioDto>();
            }

            // Comporre l'HTML (immagini in base64) è la parte pesante: thread di background.
            // La stampa vera resta sul thread UI: WebView2 non è utilizzabile da altri thread.
            var html = await Task.Run(() => GeneraDocumentoHtml(attivitaComplete));
            await PdfExportService.ExportHtmlToPdfAsync(html, percorso);

            ultimoExport = percorso;
            MostraMessaggio($"Esportato: {nomeFile}", false);
        }
        catch (Exception ex)
        {
            SegnalaErrorePdf(ex);
        }
    });

    /// <summary>
    /// Costruisce un documento HTML completo con una sezione per ogni attività (una per pagina).
    /// </summary>
    private string GeneraDocumentoHtml(IEnumerable<WorkActivityDto> lista)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>");
        sb.Append("body{font-family:'Segoe UI',sans-serif;font-size:13px;color:#212529;margin:16px;}");
        sb.Append(".attivita{margin-bottom:24px;}");
        sb.Append(".attivita + .attivita{page-break-before:always;}");
        sb.Append(".campo-label{font-weight:bold;margin-top:10px;}");
        sb.Append(".campo-valore{margin:2px 0 6px 0;}");
        sb.Append("img{max-width:100%;height:auto;}");
        sb.Append("hr{border:none;border-top:1px solid #ccc;margin:12px 0;}");
        sb.Append("</style></head><body>");
        foreach (var att in lista)
            sb.Append(GeneraHtmlAttivitaSezione(att));
        sb.Append("</body></html>");
        return sb.ToString();
    }

    /// <summary>
    /// Genera il frammento HTML di una singola attività. I campi testuali sono HtmlEncode-ati;
    /// Note e ChangesetCoinvolti sono inseriti come HTML grezzo per preservare immagini e formattazione.
    /// </summary>
    private string GeneraHtmlAttivitaSezione(WorkActivityDto att)
    {
        // Campo plain: etichetta in grassetto + valore HtmlEncode con a capo preservati.
        static string CampoPlain(string label, string? valore)
        {
            if (string.IsNullOrEmpty(valore)) return string.Empty;
            var enc = System.Net.WebUtility.HtmlEncode(valore).Replace("\n", "<br>");
            return $"<div class=\"campo-label\">{System.Net.WebUtility.HtmlEncode(label)}</div>" +
                   $"<div class=\"campo-valore\">{enc}</div>";
        }
        // Campo HTML ricco: etichetta in grassetto + valore inserito grezzo (immagini/formattazione).
        static string CampoHtml(string label, string? html)
        {
            if (string.IsNullOrEmpty(html)) return string.Empty;
            return $"<div class=\"campo-label\">{System.Net.WebUtility.HtmlEncode(label)}</div>" +
                   $"<div class=\"campo-valore\">{html}</div>";
        }

        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"attivita\">");
        sb.Append(CampoPlain("📅 Data", att.Data.ToString("dd/MM/yyyy")));
        if (!string.IsNullOrEmpty(att.TipoAttivita) && att.TipoAttivita != TipiAttivita.Lavoro)
            sb.Append(CampoPlain("🏷️ Tipo", att.TipoAttivita));
        sb.Append(CampoPlain("📝 Descrizione", att.Descrizione ?? "-"));
        sb.Append(CampoPlain("🎫 Numero del ticket", att.NumeroTicket));
        sb.Append(CampoPlain("⏳ Scadenza ticket", att.DataScadenzaTicket?.ToString("dd/MM/yyyy")));
        sb.Append(CampoPlain("🔗 URL Ticket / CR / Backlog", att.UrlTicket));
        sb.Append(CampoPlain("👤 Cliente", att.ClienteNome ?? "-"));
        sb.Append(CampoPlain("⏱️ Ore Lavorate", att.OreLavorate.ToString()));
        sb.Append(CampoPlain("🏷️ Versione attualmente in Sviluppo", att.Versione));
        sb.Append(CampoPlain("🚀 Ambienti di rilascio", FormattaAmbientiRilascio(att)));
        sb.Append(CampoPlain("👀 Vedere", att.Vedere));
        sb.Append(CampoPlain("📁 Cartella Documentazione", att.CartellaDocumentazione));
        sb.Append(CampoHtml("📋 Descrizione dettagliata lavoro svolto", att.Note));
        sb.Append(CampoPlain("✏️ Testo del check-in", att.TestoCheckIn));
        sb.Append(CampoHtml("🔢 Elenco Changeset e lista files coinvolti", att.ChangesetCoinvolti));
        sb.Append(CampoPlain("📦 URL Patch/Pacchetto nei rilasci", att.UrlPatchRilasci));
        sb.Append("</div>");
        return sb.ToString();
    }

