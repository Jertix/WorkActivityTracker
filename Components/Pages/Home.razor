        try
        {
            // La griglia non carica Note/Changeset: ricarica il record completo per la copia.
            if (attivita.Id > 0)
            {
                var completo = await ActivityService.GetActivityByIdAsync(attivita.Id, isAdminMode);
                if (completo != null) attivita = completo;
            }

            var testo = GeneraTestoAttivita(attivita);
            await JS.InvokeVoidAsync("copyToClipboard", testo);
            MostraMessaggio("Attività copiata negli appunti!", false);
        }
        catch (Exception ex)
        {
            MostraMessaggio($"Errore durante la copia: {ex.Message}", true);
        }
    }

